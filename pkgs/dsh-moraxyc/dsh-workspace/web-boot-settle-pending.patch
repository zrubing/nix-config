+  /**
+   * Wait for pending entries to activate as their injected services settle
+   * asynchronously. Bounded so a missing service cannot hang the boot page.
+   */
+  private async settlePending(ctx: Context, timeoutMs = 10_000): Promise<void> {
+    const deadline = Date.now() + timeoutMs
+    for (;;) {
+      const pending = [...ctx.loader.entries()].filter((entry) => {
+        const fiber = entry.fiber
+        return fiber !== undefined && STATE_LABELS[fiber.state] === 'pending'
+      })
+      if (pending.length === 0) return
+      if (Date.now() >= deadline) return
+      await new Promise((resolve) => setTimeout(resolve, 50))
+    }
+  }
