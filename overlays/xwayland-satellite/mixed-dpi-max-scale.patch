+/// 这个输出的 X11 坐标相对合成器逻辑坐标的倍数：全局最大 scale / 它自己的 scale。
+///
+/// 混合 DPI 下 X11 只有一个全局 scale，低 scale 的输出要按这个比例放大，让所有
+/// 输出的 X11 像素落在同一个坐标系里。
+fn output_scale_ratio(world: &World, output: Entity) -> f64 {
+    let my_scale = world
+        .get::<&OutputScaleFactor>(output)
+        .map(|scale| scale.get())
+        .unwrap_or(1.0);
+    max_output_scale(world).max(my_scale) / my_scale
+}
+
+/// 把合成器给的逻辑坐标换算成 X11 坐标。
+fn scaled_output_pos(world: &World, output: Entity, x: i32, y: i32) -> (i32, i32) {
+    let ratio = output_scale_ratio(world, output);
+    if (ratio - 1.0).abs() > f64::EPSILON {
+        (
+            (x as f64 * ratio).round() as i32,
+            (y as f64 * ratio).round() as i32,
+        )
+    } else {
+        (x, y)
+    }
+}
+
+/// 把一个输出的 x 或 y 并进全局最小偏移，返回是否发生了变化。
+fn consider_output_offset(value: i32, output: Entity, dim: &mut GlobalOutputOffsetDimension) -> bool {
+    if value < dim.value {
+        *dim = GlobalOutputOffsetDimension {
+            owner: Some(output),
+            value,
+        };
+        true
+    } else if dim.owner == Some(output) && value > dim.value {
+        // 另一个输出的位置可能比新值更小，交给调用方重算
+        dim.owner = None;
+        true
+    } else {
+        false
+    }
+}
