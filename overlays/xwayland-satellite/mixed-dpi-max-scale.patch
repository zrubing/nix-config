+/// 全局 scale 变化后，把所有输出的 X11 几何按新值重算并重新播给 Xwayland。
+///
+/// 输出的 X11 尺寸和位置都是「合成器给的原始值 × 当期全局 scale」算好后缓存的。
+/// 而合成器给的整数 `wl_output.scale` 是向上取整的（scale 1.75 报成 2），所以启动
+/// 瞬间只有整数可用时算出的全局 scale 偏大，等第一张 surface 报出真实的
+/// fractional scale 才降下来。此时若只改全局 scale 而不重算输出，就会留下一个比例
+/// 差：窗口按新 scale 尺寸化，输出却仍按旧 scale 申报，多出来的那条区域不属于任何
+/// 显示器、鼠标永远到不了 —— 表现就是窗口的边角点不中。
+pub(super) fn rescale_outputs(
+    world: &World,
+    global_output_offset: &mut GlobalOutputOffset,
+    connection: &mut impl XConnection,
+) {
+    let outputs: Vec<Entity> = world
+        .query::<&OutputDimensions>()
+        .iter()
+        .map(|(output, _)| output)
+        .collect();
+
+    // 1) 尺寸：按新比例重算存下来的原始 mode，整个 mode 列表重新播一遍
+    for output in &outputs {
+        let ratio = output_scale_ratio(world, *output);
+        let Ok(server) = world.get::<&WlOutput>(*output) else {
+            continue;
+        };
+        let Ok(mut dimensions) = world.get::<&mut OutputDimensions>(*output) else {
+            continue;
+        };
+
+        for (flags, width, height, refresh) in dimensions.modes.clone() {
+            let scaled_width = (width as f64 * ratio).round() as i32;
+            let scaled_height = (height as f64 * ratio).round() as i32;
+            if flags
+                .into_result()
+                .is_ok_and(|f| f.contains(client::wl_output::Mode::Current))
+            {
+                dimensions.width = scaled_width;
+                dimensions.height = scaled_height;
+            }
+            server.mode(convert_wenum(flags), scaled_width, scaled_height, refresh);
+        }
+
+        if let Ok(xdg) = world.get::<&XdgOutputServer>(*output) {
+            if dimensions.rotated_90 {
+                xdg.logical_size(dimensions.height, dimensions.width);
+            } else {
+                xdg.logical_size(dimensions.width, dimensions.height);
+            }
+        }
+    }
+
+    // 2) 位置：从原始逻辑坐标重算，并重新聚合全局最小偏移
+    *global_output_offset = GlobalOutputOffset {
+        x: GlobalOutputOffsetDimension {
+            owner: None,
+            value: i32::MAX,
+        },
+        y: GlobalOutputOffsetDimension {
+            owner: None,
+            value: i32::MAX,
+        },
+    };
+    for output in &outputs {
+        let Ok(dimensions) = world.get::<&OutputDimensions>(*output) else {
+            continue;
+        };
+        let (raw_x, raw_y) = (dimensions.raw_x, dimensions.raw_y);
+        drop(dimensions);
+
+        let (x, y) = scaled_output_pos(world, *output, raw_x, raw_y);
+        if let Ok(mut dimensions) = world.get::<&mut OutputDimensions>(*output) {
+            dimensions.x = x;
+            dimensions.y = y;
+        }
+        consider_output_offset(x, *output, &mut global_output_offset.x);
+        consider_output_offset(y, *output, &mut global_output_offset.y);
+    }
+
+    // 3) 推给 Xwayland：位置 + 各自窗口的 output offset
+    for output in &outputs {
+        update_global_output_offset(*output, global_output_offset, world, connection);
+    }
+
+    // 4) 已存在的 X11 窗口，它们的 SurfaceScaleFactor 也是按旧全局 scale 定的；
+    //    不刷新的话下一次 reconfigure 仍会按偏大的 scale 尺寸化。
+    let max_scale = max_output_scale(world);
+    let surfaces: Vec<Entity> = world
+        .query::<(&PreferredScaleFactor, &WindowData)>()
+        .iter()
+        .map(|(surface, _)| surface)
+        .collect();
+    for surface in surfaces {
+        let raw = match world.get::<&PreferredScaleFactor>(surface) {
+            Ok(raw) => raw.0,
+            Err(_) => continue,
+        };
+        let scale = max_scale.max(raw);
+        {
+            let Ok(mut factor) = world.get::<&mut SurfaceScaleFactor>(surface) else {
+                continue;
+            };
+            if (factor.0 - scale).abs() <= f64::EPSILON {
+                continue;
+            }
+            factor.0 = scale;
+        }
+        update_surface_viewport(world, world.query_one(surface).unwrap());
+    }
+}
+
+/// Largest scale among the currently known outputs.
+///
+/// X11 only has one global scale, so in a mixed-DPI setup every X11 client gets the
+/// largest output scale and the lower-DPI outputs downsample the result. Picking the
+/// smallest scale instead (upstream's default) makes X11 apps blurry and oversized on
+/// HiDPI outputs. This mirrors what KWin does.
+pub(super) fn max_output_scale(world: &World) -> f64 {
+    world
+        .query::<&OutputScaleFactor>()
+        .iter()
+        .map(|(_, scale)| scale.get())
+        .fold(0.0, f64::max)
+}
