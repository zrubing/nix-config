+(defun doom-loaddefs--make-autoload (form file)
+  "Return FORM as an autoload form, pointing at FILE.
+`loaddefs-generate--make-autoload' gained a LOAD-NAME argument in Emacs 32, which
+the deprecated `make-autoload' alias wasn't updated for; dispatch on its arity so
+that either signature gets the arguments it expects."
+  (pcase (car (func-arity #'loaddefs-generate--make-autoload))
+    (3 (loaddefs-generate--make-autoload form (abbreviate-file-name file) file))
+    (_ (loaddefs-generate--make-autoload form (abbreviate-file-name file)))))
+
