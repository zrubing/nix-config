+(defun doom-loaddefs--insert-autoloads (file)
+  "Insert the ;;;###autoload forms in FILE into the current buffer.
+
+The deprecated `autoload-generate-file-autoloads' cannot be used for this on
+Emacs 32: `lisp/obsolete/autoload.el' still calls
+`loaddefs-generate--make-autoload' with the old two-argument signature (it takes
+three now), so every cookie fails to expand, which leaves no output for it to
+write and trips its own `(cl-assert (> (point) output-start))'. Scan with
+`loaddefs-generate--parse-file' instead -- it is what `loaddefs-generate' uses,
+and its signature hasn't changed since Emacs 29."
+  ;; `loaddefs-generate--parse-file' returns the forms in reverse order; its
+  ;; caller, `loaddefs-generate', reverses them back when it writes them out.
+  (dolist (def (reverse (loaddefs-generate--parse-file
+                         file (expand-file-name "loaddefs.el"
+                                                (file-name-directory file)))))
+    (let ((form (doom-loaddefs--fix-load-names
+                 (nth 2 def)
+                 (abbreviate-file-name (file-name-sans-extension file)))))
+      (if (stringp form)        ;cookie followed by text on the same line
+          (insert form)
+        ;; Emacs' own printer for the forms it scrapes.
+        (loaddefs-generate--print-form form))
+      (insert "\n"))))
+
+(defun doom-loaddefs--fix-load-names (form path)
+  "Replace FORM's file references with PATH.
+`loaddefs-generate--parse-file' bakes the load name Emacs computed for the
+scanned file into them (usually a name relative to the loaddefs file, e.g.
+\"lib/files\"), which Doom's profiles can't resolve, so restore the abbreviated,
+extension-less path Doom's loaddefs have always recorded there."
+  (cond ((not (consp form)) form)
+        ((memq (car form) '(autoload custom-autoload))
+         (when (stringp (nth 2 form))
+           (setf (nth 2 form) path))
+         form)
+        ((memq (car form) '(progn prog1 eval-and-compile let))
+         (dolist (sub (cdr form))
+           (doom-loaddefs--fix-load-names sub path))
+         form)
+        (form)))
+
