diff --git a/src/components/messages/bodyWindow.ts b/src/components/messages/bodyWindow.ts
new file mode 100644
index 0000000..edce04c
--- /dev/null
+++ b/src/components/messages/bodyWindow.ts
@@ -0,0 +1,22 @@
+/**
+ * Shared body-line budgets for transcript cards.
+ *
+ * The renderer (AssistantToolUseMessage / AssistantThinkingMessage) and the
+ * virtualizer's height estimator (MessageList) must agree on these numbers:
+ * an estimate that disagrees with the real card height is a scroll jump, and
+ * two copies of the same constant drift the first time one of them changes.
+ */
+
+/** Collapsed text body: three lines, then the fold marker. */
+export const COLLAPSED_BODY_MAX_LINES = 3
+
+/** Diff bodies cap at the upstream chat row's 8 (dsh-client-ui-tool's
+ *  CHAT_DIFF_MAX_LINES) — denser information than log output. */
+export const DIFF_BODY_MAX_LINES = 8
+
+/** Verbose (Ctrl+O / expanded) bodies render through a bounded line window:
+ *  a full result can be tens of thousands of lines, and laying that out in
+ *  one render builds a Yoga tree the frame budget cannot pay. The window
+ *  keeps the head readable and says exactly how much of the retained source
+ *  it is showing — the source itself keeps every line. */
+export const VERBOSE_BODY_WINDOW = 400
