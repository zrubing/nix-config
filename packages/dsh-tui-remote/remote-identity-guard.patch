+/**
+ * Read the session tag off a caller context without letting cordis's proxy
+ * throw.
+ *
+ * `candidate?.dshRemoteSessionId` is NOT optional-safe: the context proxy
+ * raises `cannot get property "dshRemoteSessionId" without inject` for every
+ * context that does not carry the extension, so `?.` never sees `undefined`.
+ * The Gateway probes `identity(callerCtx)` before routing a scoped remote call;
+ * a call made from a non-session context (the registry `/compact` path) then
+ * aborted with that cordis message instead of falling back to the direct route.
+ * A probe must be total: no tag means "not one of my scopes".
+ */
+const identify = (candidate: unknown): string | undefined => {
+  try {
+    return (candidate as SessionScope | undefined)?.dshRemoteSessionId
+  } catch {
+    return undefined
+  }
+}
