+/**
+ * True when the receiving terminal is Ghostty, using the same env and
+ * XTVERSION evidence as the notification protocol probe.
+ * @returns true for Ghostty, including a probed name over SSH.
+ */
+export function isGhostty(): boolean {
+  const program = process.env.TERM_PROGRAM?.toLowerCase()
