+} else if (command === 'effort' && sessionId !== undefined) {
+  const handle = await openRemoteSession(deps, sessionId)
+  const effort = handle.session.capabilities.effort
+  process.stderr.write(`[probe] before levels=${JSON.stringify(effort?.levels())} current=${String(effort?.current())}\n`)
+  await effort?.set(seconds ?? null)
+  await new Promise((resolve) => setTimeout(resolve, 600))
+  process.stderr.write(`[probe] after set(${String(seconds)}) current=${String(effort?.current())}\n`)
+  await handle.close()
+} else if (command === 'ask' && sessionId !== undefined) {
+  // `ask <sessionId> <provider/model> <text>`: switch, prompt, and report the
+  // turn's own outcome — the cheapest way to tell a broken route from a bug.
+  const [model = '', ...words] = (seconds ?? '').split(' ')
+  const handle = await openRemoteSession(deps, sessionId)
+  const models = handle.session.capabilities.models
+  const outcome = await models?.set({ ...(model.includes('/') ? { provider: model.split('/')[0] } : {}), model: model.includes('/') ? model.split('/')[1] ?? '' : model })
+  process.stderr.write(`[probe] model ${model} -> ${JSON.stringify(outcome)}\n`)
+  handle.session.subscribe((batch) => {
+    for (const event of batch) {
+      if (event.type === 'turn.end') process.stderr.write(`[probe] turn.end ${JSON.stringify(event)}\n`)
+      if (event.type === 'assistant.message') {
+        const text = event.blocks.map((block) => (block.type === 'text' ? block.text : `[${block.type}]`)).join('')
+        process.stderr.write(`[probe] assistant: ${text.slice(0, 200)}\n`)
+      }
+      if (event.type === 'notice') process.stderr.write(`[probe] notice: ${JSON.stringify(event)}\n`)
+      if (event.type === 'tool.call') process.stderr.write(`[probe] tool.call ${event.name} ${event.argsJson.slice(0, 160)}\n`)
+      if (event.type === 'permission.request') {
+        process.stderr.write(`[probe] PERMISSION ${JSON.stringify(event.request)}\n`)
+        // Answer like the panel's Enter: one grant, through the capability
+        // the channel would call.
+        setTimeout(() => {
+          handle.session.capabilities.permissions?.respond(event.request.requestId, { kind: 'allow-once' })
+          process.stderr.write('[probe] answered allow-once\n')
+        }, 800)
+      }
+      if (event.type === 'permission.settled') process.stderr.write(`[probe] permission.settled ${event.requestId} ${event.outcome}\n`)
+    }
+  })
+  const submitted = await handle.session.submit({ clientMessageId: crypto.randomUUID(), text: words.join(' ') || 'Reply with OK only.' }, 'turn')
+  process.stderr.write(`[probe] submit ${JSON.stringify(submitted)}\n`)
+  await new Promise((resolve) => setTimeout(resolve, 30000))
+  await handle.close()
+} else if (command === 'fork' && sessionId !== undefined) {
+  const handle = await openRemoteSession(deps, sessionId)
+  const capability = handle.session.capabilities.fork
+  if (capability === undefined) throw new Error('probe: no fork capability')
+  const ref = await capability.fork(undefined, 'remote fork probe')
