+/**
+ * The Host's session store as a backend catalog.
+ *
+ * `session/list` answers host-wide in one call: identity, activity, parentage
+ * and the folded projections each row carries. What it does not publish is the
+ * session header — no creation time, no log size, no git note — so those stay
+ * undefined here rather than being approximated: the picker renders what it
+ * knows and omits the rest. Subagent depth is the one derived fact, walked from
+ * the parent links in the same listing.
+ */
+import type { SessionCatalog } from '../../agent/backend.js'
+import type { SessionKind, SessionSummary, SessionTitle } from '../../adapter/ports/channel-session.js'
+import type { SessionListScope } from '../../agent/backend.js'
+import type { RemoteResult } from './connection.js'
+import { listRemoteSessions, type RemoteSessionSummary } from './session.js'
+
+/** The `session/list` surface this catalog calls. */
+export interface CatalogRemote {
+  list(request: { readonly cursor?: string }): Promise<RemoteResult<{ readonly items: readonly RemoteSessionSummary[] }>>
+  rename(request: { readonly sessionId: string; readonly title: string }): Promise<RemoteResult<unknown>>
+}
+
+/** A path's last segment, for a session that never recorded a title. */
+function leafOf(path: string): string {
+  const trimmed = path.replace(/\/+$/, '')
+  const index = trimmed.lastIndexOf('/')
+  return index === -1 ? trimmed : trimmed.slice(index + 1)
+}
+
+/**
+ * How deep a subagent run sits: the number of `origin: 'subagent'` links
+ * between it and its first non-subagent ancestor.
+ */
+function subagentDepth(row: RemoteSessionSummary, byId: ReadonlyMap<string, RemoteSessionSummary>): number {
+  let depth = 1
+  let parent = row.parentSessionId
+  const seen = new Set<string>([row.sessionId])
+  while (parent !== undefined && !seen.has(parent)) {
+    seen.add(parent)
+    const next = byId.get(parent)
+    if (next === undefined || next.origin !== 'subagent') break
+    depth += 1
+    parent = next.parentSessionId
+  }
+  return depth
+}
+
+/**
+ * One listing row as the picker's summary.
+ * @param row - the Host's row.
+ * @param byId - every row of the same listing (subagent depth, child counts).
+ * @returns the summary; fields the Host does not publish stay undefined.
+ */
+function toSummary(row: RemoteSessionSummary, byId: ReadonlyMap<string, RemoteSessionSummary>): SessionSummary {
+  const values = row.projections?.values
+  const title = values?.title ?? null
+  const fallback = leafOf(row.cwd ?? '') || row.sessionId
+  const titleView: SessionTitle = title === null
+    ? { text: fallback, source: 'fallback' }
+    // The API carries the folded title only: a rename and the automatic first
+    // title are the same fact here. Both render undimmed, so nothing is lost.
+    : { text: title, source: 'auto' }
+  const kind: SessionKind = row.origin === 'subagent'
+    ? { kind: 'subagent', parent: row.parentSessionId, depth: subagentDepth(row, byId) }
+    : row.parentSessionId === undefined
+      ? { kind: 'root' }
+      : { kind: 'fork', parent: row.parentSessionId }
+  let childCount = 0
+  for (const candidate of byId.values()) {
+    if (candidate.parentSessionId === row.sessionId) childCount += 1
+  }
+  return {
+    id: row.sessionId,
+    kind,
+    title: titleView,
+    cwd: row.cwd ?? '',
+    updatedAt: row.updatedAt ?? 0,
+    bytes: undefined,
+    hasPrompt: row.blank !== true,
+    agentPreset: values?.agentPreset ?? undefined,
+    model: values?.modelSelection?.lastUsed?.model,
+    label: undefined,
+    branch: undefined,
+    childCount,
+  }
+}
+
+/**
+ * Build the catalog over one connection.
+ * @param remote - mounted client Remote service.
+ * @returns the backend catalog the channel's `/resume` and session browser read.
+ */
+export function createRemoteSessionCatalog(remote: unknown): SessionCatalog {
+  const sessions = (remote as unknown as { readonly session: CatalogRemote }).session
+
+  const readAll = async (): Promise<readonly SessionSummary[]> => {
+    const rows = await listRemoteSessions(remote)
+    const byId = new Map(rows.map((row) => [row.sessionId, row]))
+    return rows
+      .map((row) => toSummary(row, byId))
+      .sort((left, right) => right.updatedAt - left.updatedAt)
+  }
+
+  return {
+    // `session/list` publishes no scope filter and no page cursor: the Host
+    // answers host-wide, so the workspace scope is applied here.
+    async list(scope?: SessionListScope) {
+      const all = await readAll()
+      if (scope?.allProjects === true || scope?.cwd === undefined) return all
+      return all.filter((row) => row.cwd === scope.cwd)
+    },
+    async info(sessionId) {
+      return (await readAll()).find((row) => row.id === sessionId)
+    },
+    async rename(sessionId, title) {
+      const result = await sessions.rename({ sessionId, title })
+      if (!result.ok) throw new Error(`remote: session/rename failed: ${result.error?.message ?? 'unknown error'}`)
+    },
+  }
+}
diff --git a/src/dsh-adapter/remote/startup.ts b/src/dsh-adapter/remote/startup.ts
new file mode 100644
index 0000000..2b63602
--- /dev/null
+++ b/src/dsh-adapter/remote/startup.ts
@@ -0,0 +1,115 @@
+/**
+ * Remote startup: the pieces the boot needs from a backend, built on top of the
+ * host connection instead of a child process.
+ *
+ * Mirrors `prepareBackendStartup`'s return shape so the boot can use it
+ * unchanged (`backendStart`): the channel, `/resume`, `/new` and the persisted
+ * markers all keep working, while the transcript lives in another process.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import type { AgentSession } from '../../agent/session.js'
+import type { AgentEvent } from '../../agent/events.js'
+import type { BackendSessionPrefs } from '../../agent/backend.js'
+import { bindRemoteCommands, refreshRemoteCommands } from './commands.js'
+import { connectRemote, type RemoteConnection } from './connection.js'
+import { createRemoteSession, listRemoteSessions, openRemoteSession, type RemoteSessionSummary } from './session.js'
+import { createRemoteSessionCatalog } from './sessions.js'
+
+export interface RemoteStartupOptions {
+  /** Host base URL, e.g. `http://127.0.0.1:3080`. */
+  readonly url: string
+  /** Directory a newly created session would own. */
+  readonly cwd: string
+  /** Session to resume; the most recent host session otherwise. */
+  readonly sessionId?: string
+}
+
+/**
+ * The Session a fresh launch in `cwd` should open: the most recently updated
+ * ordinary Session recorded in that directory, or none (the caller creates a
+ * new one there).
+ *
+ * `session/list` is host-wide, so picking its first row would drop a launch in
+ * one workspace into whatever Session another workspace used last — the same
+ * scope rule `/resume` applies, applied before the first paint.
+ */
+export function startupSessionFor(sessions: readonly RemoteSessionSummary[], cwd: string): string | undefined {
+  const normalize = (value: string | undefined): string => (value ?? '').replace(/\/+$/, '')
+  const target = normalize(cwd)
+  if (target === '') return undefined
+  let best: RemoteSessionSummary | undefined
+  for (const row of sessions) {
+    if (row.origin === 'subagent') continue
+    if (normalize(row.cwd) !== target) continue
+    if (best === undefined || (row.updatedAt ?? 0) > (best.updatedAt ?? 0)) best = row
+  }
+  return best?.sessionId
+}
+
+/**
+ * Connect to the host and open its startup session.
+ * @param ctx - the TUI plugin's context (the client plugins mount under it).
+ * @param options - host URL, cwd, and an optional session to resume.
+ * @returns the boot's backend-startup record plus the connection it owns.
+ */
+export async function openRemoteStartup(ctx: Context, options: RemoteStartupOptions) {
+  const connection = await connectRemote(options.url, ctx as unknown as Parameters<typeof connectRemote>[1])
+  const deps = { remote: connection.remote, projections: connection.projections, catalog: connection.catalog, approvals: connection.approvals }
+  const sessions = await listRemoteSessions(connection.remote)
+  const target = options.sessionId ?? startupSessionFor(sessions, options.cwd)
+  const sessionId = target ?? (await createRemoteSession(connection.remote, options.cwd))
+  if (process.env.DSH_TUI_REMOTE_DEBUG === '1') {
+    process.stderr.write(`remote: sessions=[${sessions.map((s) => s.sessionId).join(',')}] opening=${sessionId}\n`)
+  }
+  const handle = await openRemoteSession(deps, sessionId)
+  const initialHistory = await handle.session.history()
+  // The TUI reads the registry synchronously (`/compact` gating, Help); the
+  // service caches one session's descriptors and is refreshed on every switch.
+  await bindRemoteCommands(connection.remote, sessionId)
+
+  let last = sessionId
+  const sessionPrefs: BackendSessionPrefs = {
+    lastSession: () => last,
+    setLastSession: (id) => { last = id },
+    touch: () => {},
+    forget: () => {},
+  }
+
+  return {
+    resumedSessionId: options.sessionId,
+    label: 'DSH · remote',
+    backendId: 'dsh',
+    // The session's route is known before its first turn (the Host records it
+    // or serves the deployment default), so the status line never has to name
+    // the backend as a stand-in.
+    route: handle.route,
+    ...(handle.agentPreset === undefined ? {} : { agentPreset: handle.agentPreset }),
+    catalog: createRemoteSessionCatalog(connection.remote),
+    sessionPrefs,
+    start: async (): Promise<{
+      session: AgentSession
+      initialHistory: readonly AgentEvent[]
+      route: { readonly provider: string; readonly model: string }
+      agentPreset?: string
+    }> => ({
+      session: handle.session,
+      initialHistory,
+      route: handle.route,
+      ...(handle.agentPreset === undefined ? {} : { agentPreset: handle.agentPreset }),
+    }),
+    persisted: (_sessionId: string, rows: readonly { readonly kind: string }[]) => rows.some((row) => row.kind === 'user'),
+    resumeCommand: (id: string) => `dsh-tui --remote ${options.url} --resume ${id}`,
+    open: async (target: { readonly kind: 'create'; readonly cwd: string } | { readonly kind: 'resume'; readonly sessionId: string }): Promise<AgentSession> => {
+      if (target.kind === 'create') {
+        const created = await createRemoteSession(connection.remote, target.cwd)
+        await refreshRemoteCommands(created)
+        return (await openRemoteSession(deps, created)).session
+      }
+      await refreshRemoteCommands(target.sessionId)
+      return (await openRemoteSession(deps, target.sessionId)).session
+    },
+    session: handle.session,
+    initialHistory,
+    connection: connection as RemoteConnection,
+  }
+}
diff --git a/src/dsh-adapter/remote/verify.ts b/src/dsh-adapter/remote/verify.ts
new file mode 100644
index 0000000..af5ef78
--- /dev/null
+++ b/src/dsh-adapter/remote/verify.ts
@@ -0,0 +1,164 @@
+/**
+ * Contract check for the remote client: every place where this fork reads a
+ * host surface goes through here, so an upstream upgrade that moves a method or
+ * an event field fails loudly instead of failing silently in the TUI.
+ *
+ *   node lib/types/dsh-adapter/remote/verify.js [baseUrl] [--no-live]
+ *
+ * `--no-live` stops after the static surface (descriptors + mounted methods);
+ * the live half creates one throwaway session and asserts the event fields the
+ * adapter reads.
+ */
+import { findHostDsh } from '../host-dsh.js'
+import { connectRemote, type RemoteApi } from './connection.js'
+import { createRemoteSession, openRemoteSession } from './session.js'
+
+/** Methods `remote/session.ts` and `remote/sessions.ts` call. */
+const SESSION_METHODS = [
+  'attachment',
+  'cancel',
+  'control',
+  'create',
+  'follow',
+  'fork',
+  'list',
+  'modelCatalog',
+  'page',
+  'projections',
+  'prompt',
+  'rename',
+  'selectModel',
+] as const
+
+/** Methods `remote/commands.ts` and the compact capability call. */
+const COMMANDS_METHODS = ['execute', 'list'] as const
+
+/** Translated event kinds the channel consumes; the translator renames the wire
+ *  vocabulary (`turn/start` → `turn.start`), so both halves are checked. */
+const LIVE_EVENTS = ['turn.start', 'user.message', 'assistant.message', 'turn.end'] as const
+
+interface Report {
+  ok: boolean
+  line: string
+}
+
+const reports: Report[] = []
+
+function check(ok: boolean, line: string): void {
+  reports.push({ ok, line })
+  process.stdout.write(`${ok ? '[ok]  ' : '[FAIL]'} ${line}\n`)
+}
+
+function fail(line: string): never {
+  reports.push({ ok: false, line })
+  process.stdout.write(`[FAIL] ${line}\n`)
+  finish()
+}
+
+function finish(): never {
+  const failed = reports.filter((report) => !report.ok)
+  process.stdout.write(`\n${reports.length - failed.length}/${reports.length} checks passed\n`)
+  process.exit(failed.length === 0 ? 0 : 1)
+}
+
+const argv = process.argv.slice(2)
+const live = !argv.includes('--no-live')
+// An empty argument (a shell that always passes "$1") must not shadow the
+// default: `connectRemote('')` would hang on the client root instead of failing.
+const baseUrl = argv.find((argument) => argument !== '' && !argument.startsWith('--'))
+  ?? process.env.DSH_TUI_REMOTE_URL
+  ?? 'http://127.0.0.1:3080'
+
+const location = findHostDsh()
+if (!('packageDir' in location)) fail(`host install not resolvable: ${location.reason}`)
+check(true, `host install: ${location.packageDir}`)
+
+const connection = await connectRemote(baseUrl)
+check(true, `connected: ${baseUrl}`)
+
+const remote = connection.remote as RemoteApi & {
+  session?: Record<string, unknown>
+  commands?: Record<string, unknown>
+}
+
+const session = remote.session
+if (session === undefined) fail('the host mounted no `session` namespace')
+check(true, 'namespace: session')
+const missingSession = SESSION_METHODS.filter((method) => typeof session[method] !== 'function')
+check(missingSession.length === 0, `session methods (${SESSION_METHODS.length}): ${missingSession.length === 0 ? 'all present' : `missing ${missingSession.join(', ')}`}`)
+
+const commands = remote.commands
+check(commands !== undefined, 'namespace: commands (dsh-commands descriptor mounted)')
+if (commands !== undefined) {
+  const missingCommands = COMMANDS_METHODS.filter((method) => typeof commands[method] !== 'function')
+  check(missingCommands.length === 0, `commands methods: ${missingCommands.length === 0 ? COMMANDS_METHODS.join(', ') : `missing ${missingCommands.join(', ')}`}`)
+}
+
+if (!live) finish()
+
+// ── live half: one throwaway session, one turn ──────────────────────────────
+const sessionId = await createRemoteSession(remote, '/tmp')
+check(true, `scratch session: ${sessionId}`)
+
+const handle = await openRemoteSession(
+  { remote, projections: connection.projections, catalog: connection.catalog, approvals: connection.approvals },
+  sessionId,
+)
+
+const seen = new Set<string>()
+const unsubscribe = handle.session.subscribe((batch) => {
+  for (const event of batch) seen.add(event.type)
+})
+
+// The translator rewrites `user.message`, so the wire field the adapter claims
+// on has to be read from the raw stream — that is the contract being checked.
+let echoedRpcId: string | undefined
+interface FollowFrame {
+  readonly type: string
+  readonly event?: { readonly type: string; readonly data?: { readonly source?: { readonly rpcId?: string } } }
+}
+const follow = remote.session?.['follow'] as
+  | ((args: { address: { kind: 'session'; sessionId: string }; maxMessages: number }) => AsyncIterable<FollowFrame>)
+  | undefined
+const rawLoop = (async () => {
+  if (follow === undefined) return
+  const stream = follow({ address: { kind: 'session', sessionId }, maxMessages: 100 })
+  for await (const frame of stream) {
+    if (frame.type === 'event' && frame.event?.type === 'user/message') {
+      echoedRpcId = frame.event.data?.source?.rpcId
+      return
+    }
+  }
+})()
+
+const clientMessageId = `verify-${Date.now()}`
+const submitted = await handle.session.submit({ clientMessageId, text: 'reply with the single word: ok', images: [] }, 'followup')
+check(submitted.accepted, 'session/prompt accepted')
+
+const deadline = Date.now() + 60_000
+let turnEnded = false
+while (Date.now() < deadline && !turnEnded) {
+  await new Promise((resolve) => setTimeout(resolve, 500))
+  turnEnded = (await handle.session.history()).some((event) => event.type === 'turn.end')
+}
+unsubscribe()
+await Promise.race([rawLoop, new Promise((resolve) => setTimeout(resolve, 5000))])
+
+const missingLive = LIVE_EVENTS.filter((type) => !seen.has(type))
+check(missingLive.length === 0, `live events: ${missingLive.length === 0 ? LIVE_EVENTS.join(', ') : `missing ${missingLive.join(', ')}`}`)
+
+// The pending preview is retired by the adapter's claim; the echo must still
+// carry our id or the transcript and the queue disagree (see design doc §29).
+check(echoedRpcId === clientMessageId, `user.message.source.rpcId carries the client id (${String(echoedRpcId)})`)
+
+// `/compact` availability is gated on this capability, so its absence is a
+// contract break even when the command itself is not exercised here.
+const compact = (handle.session.capabilities as { compact?: { run?: unknown } }).compact
+check(typeof compact?.run === 'function', 'session capabilities: compact.run present')
+
+const descriptors = await (commands as { list(sessionId: string): Promise<{ ok: boolean; value?: readonly { name: string }[] }> }).list(sessionId)
+const names = descriptors.ok ? (descriptors.value ?? []).map((descriptor) => descriptor.name) : []
+check(names.includes('compact'), `commands/list includes /compact (${names.length} commands)`)
+
+await connection.close()
+finish()
