diff --git a/src/dsh-adapter/remote/approval-check.ts b/src/dsh-adapter/remote/approval-check.ts
new file mode 100644
index 0000000..ce6b84e
--- /dev/null
+++ b/src/dsh-adapter/remote/approval-check.ts
@@ -0,0 +1,150 @@
+/**
+ * Deterministic check of the remote approval half (no Host involved).
+ *
+ * The Host supplies `approval/request` through the Remote Event channel; this
+ * script stands in for that channel and drives the session adapter's own
+ * answerer: the view it emits, the channel's `respond`, and the settle event.
+ * It proves the half this repository owns; the Gateway's scoped dispatch is
+ * the Host-facing half and needs a live ask to observe.
+ *
+ * Usage: node --import tsx/esm src/dsh-adapter/remote/approval-check.ts
+ */
+import { openApprovals, type RemoteApprovalAsk } from './approvals.js'
+import { createRemoteCatalog } from './catalog.js'
+import { openRemoteSession, type SessionRemote } from './session.js'
+
+const catalog = {
+  default: { provider: 'p', model: 'm' },
+  routableProviders: ['p'],
+  groups: [{ id: 'p', name: 'P', models: [{ id: 'm', name: 'M' }] }],
+  failures: [],
+}
+
+const session: SessionRemote = {
+  follow() {
+    return {
+      [Symbol.asyncIterator]: async function* () {
+        yield {
+          type: 'snapshot' as const,
+          header: { id: 's1', cwd: '/tmp' },
+          cursor: 0,
+          records: [],
+          hasMore: false,
+        }
+        // The stream ends right after the snapshot: approvals do not ride it,
+        // and a parked generator would stall `dispose()` on this fake.
+      },
+    }
+  },
+  async list() { return { ok: true, value: { items: [] } } },
+  async rename() { return { ok: true } },
+  async attachment() { return { ok: false, error: { code: 'unused', message: 'not used by this check' } } },
+  async fork() { return { ok: true, value: { sessionId: 's2' } } },
+  async create() { return { ok: true, value: { sessionId: 's1' } } },
+  async cancel() { return { ok: true, value: { accepted: true } } },
+  async modelCatalog() { return { ok: true, value: catalog } },
+  async selectModel() { return { ok: true, value: { selected: { provider: 'p', model: 'm' } } } },
+  async prompt() { return { ok: true, value: { accepted: true } } },
+}
+
+const remote = { session }
+const projections = {
+  ready: Promise.resolve(),
+  values: () => undefined,
+  get: () => undefined,
+  subscribe: () => () => {},
+  close: async () => {},
+}
+
+type Dispatched = (this: unknown, request: unknown, next: () => Promise<unknown>) => Promise<unknown>
+let dispatched: Dispatched | undefined
+let dispatchedQuestion: Dispatched | undefined
+const scopes = new Map<string, unknown>()
+const ctx = {
+  plugin: () => {},
+  get: (name: string) =>
+    name === 'typert'
+      ? {
+          contexts: {
+            registerClient: (_key: string, adapter: { resolve(id: string): unknown }) => {
+              scopes.set('resolve', adapter.resolve)
+              return () => {}
+            },
+          },
+        }
+      : undefined,
+  extend: (properties: Record<string, unknown>) => ({ dshRemoteSessionId: properties.dshRemoteSessionId }),
+}
+const eventRemote = {
+  $on: (event: string, listener: Dispatched) => {
+    if (event === 'approval/request') dispatched = listener
+    else dispatchedQuestion = listener
+    return () => {}
+  },
+}
+
+const approvals = openApprovals(ctx as never, eventRemote)
+const handle = await openRemoteSession(
+  { remote, projections, catalog: createRemoteCatalog(remote), approvals },
+  's1',
+)
+const resolve = scopes.get('resolve') as (id: string) => { dshRemoteSessionId?: string } | undefined
+const scope = resolve('s1')
+if (scope?.dshRemoteSessionId !== 's1') throw new Error('check: the client agent scope does not resolve s1')
+if (resolve('other') !== undefined) throw new Error('check: an unfollowed Agent must resolve to nothing')
+if (dispatched === undefined) throw new Error('check: no approval/request listener was registered')
+
+const seen: string[] = []
+handle.session.subscribe((batch) => {
+  for (const event of batch) {
+    seen.push(event.type)
+    if (event.type === 'question.request') {
+      process.stderr.write(`[check] ask ${JSON.stringify(event.request)}\n`)
+      handle.session.capabilities.questions?.respond(event.request.requestId, {
+        answers: [{ selected: ['y'] }, { selected: [], custom: 'note' }],
+      })
+    }
+    if (event.type === 'permission.request') {
+      process.stderr.write(`[check] view ${JSON.stringify(event.request)}\n`)
+      // The channel's own Enter key decision, applied through the capability.
+      handle.session.capabilities.permissions?.respond(event.request.requestId, { kind: 'allow-once' })
+    }
+  }
+})
+
+const outcome = await dispatched!.call(scope, {
+  toolName: 'bash',
+  callId: 'call-1',
+  reason: 'needs to write outside the workspace',
+}, async () => 'unavailable')
+
+process.stderr.write(`[check] outcome=${String(outcome)} events=${seen.join(',')}\n`)
+if (outcome !== 'allowed-once') throw new Error(`check: expected allowed-once, got ${String(outcome)}`)
+if (!seen.includes('permission.request') || !seen.includes('permission.settled')) throw new Error('check: the park/settle pair did not reach the channel')
+
+const rejected = await dispatched!.call(scope, { toolName: 'bash' }, async () => 'unavailable')
+process.stderr.write(`[check] second outcome=${String(rejected)}\n`)
+if (rejected !== 'allowed-once') throw new Error(`check: the router must keep answering later asks (${String(rejected)})`)
+
+// Ask-user: the same transport, answered by position through the panel's
+// contract while the Host is handed its own question ids back.
+if (dispatchedQuestion === undefined) throw new Error('check: no user-questions listener was registered')
+const asked = await dispatchedQuestion.call(scope, {
+  questions: [
+    { id: 'q-a', question: 'Pick one', options: [{ label: 'x' }, { label: 'y' }] },
+    { id: 'q-b', question: 'Anything else?', multiSelect: true },
+  ],
+  wait: { callId: 'call-q' },
+}, async () => ({ answers: [] }))
+process.stderr.write(`[check] answered=${JSON.stringify(asked)}\n`)
+if (JSON.stringify(asked) !== JSON.stringify({ answers: [{ id: 'q-a', selected: ['y'] }, { id: 'q-b', selected: [], custom: 'note' }] })) {
+  throw new Error(`check: the ask-user answer was not re-keyed to the Host's question ids (${JSON.stringify(asked)})`)
+}
+
+await handle.close()
+// A closed session stops answering: the router must hand the ask back to the
+// Host's chain instead of claiming it (`next()`), which is what fails closed.
+const afterClose = await dispatched!.call(scope, { toolName: 'bash' }, async () => 'unavailable')
+if (afterClose !== 'unavailable') throw new Error(`check: a closed session must not claim asks (${String(afterClose)})`)
+approvals.dispose()
+process.stderr.write('[check] ok\n')
