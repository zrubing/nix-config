@@ -0,0 +1,693 @@
+/**
+ * Remote DSH session: the host's durable log and live frames presented as an
+ * `AgentSession`, so the channel and the UI render a session owned by another
+ * process exactly like one booted in-process.
+ *
+ * M1 is read-only: `submit` and `cancel` refuse. The durable log stays the
+ * source of truth — the translator maps the host's `SessionEvent`s and
+ * assistant-stream frames into the shared Agent Domain.
+ */
+import type { AssistantStreamFrame } from '@deepseek-ai/dsh-agent'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { AgentSession, AgentSessionStatus, CancelCause, CancelReceipt, AgentInput, SubmitPlacement } from '../../agent/session.js'
+import type { AgentEvent, AgentEventMeta } from '../../agent/events.js'
+import type { EffortOption, ImageLimitsView, ModelRef, ModelSwitchOutcome, PermissionDecision, SessionCapabilities } from '../../agent/capabilities.js'
+import type { ImageRef, PermissionOptionView, PermissionOutcome, PermissionRequestView, QuestionRequestView } from '../../agent/events.js'
+import type { AgentSessionRef } from '../../agent/refs.js'
+import { createDshTranslator } from '../backend/translate.js'
+import type { RemoteResult, RemoteStream } from './connection.js'
+import type { RemoteApprovals, ApprovalOutcome, RemoteQuestionAnswer } from './approvals.js'
+import type { RemoteCatalog, ModelCatalog } from './catalog.js'
+import type { ModelSelectionProjection, RemoteProjections } from './projections.js'
+
+/** The `session/*` methods this adapter calls. */
+export interface SessionRemote {
+  follow(request: {
+    readonly address: { readonly kind: 'session'; readonly sessionId: string }
+    readonly maxMessages?: number
+    /** Opt in to the transient per-token frames. Without it the Host sends
+     *  only durable events, so a turn appears whole when it settles. */
+    readonly assistantStream?: boolean
+  }): RemoteStream<FollowFrame>
+  list(request: { readonly cursor?: string }): Promise<RemoteResult<{ readonly items: readonly RemoteSessionSummary[] }>>
+  rename(request: { readonly sessionId: string; readonly title: string }): Promise<RemoteResult<unknown>>
+  create(request: { readonly cwd?: string }): Promise<RemoteResult<{ readonly sessionId: string }>>
+  cancel(request: { readonly sessionId: string }): Promise<RemoteResult<{ readonly accepted: boolean }>>
+  /** Copy one exact event prefix into a new Session. */
+  fork(request: {
+    readonly sessionId: string
+    readonly atSeq?: number
+  }): Promise<RemoteResult<{ readonly sessionId: string }>>
+  /** One image's verified reference and base64 bytes. */
+  attachment(request: { readonly sessionId: string; readonly attachmentId: string }): Promise<RemoteResult<{
+    readonly attachment: {
+      readonly attachmentId: string
+      readonly mediaType: string
+      readonly bytes: number
+      readonly width: number
+      readonly height: number
+      readonly name?: string
+    }
+    readonly data: string
+  }>>
+  /** Rename one Session (used to name a fork). */
+  rename(request: { readonly sessionId: string; readonly title: string }): Promise<RemoteResult<unknown>>
+  /** Host-wide: one catalog for every Session selector, no parameters. */
+  modelCatalog(): Promise<RemoteResult<ModelCatalog>>
+  selectModel(request: {
+    readonly sessionId: string
+    readonly provider: string
+    readonly model: string
+    readonly reasoningEffort?: string
+  }): Promise<RemoteResult<{ readonly selected: { readonly provider: string; readonly model: string; readonly reasoningEffort?: string } }>>
+  prompt(request: {
+    readonly requestId: string
+    readonly sessionId: string
+    readonly mode: 'queue' | 'steer'
+    readonly content: readonly PromptContent[]
+  }): Promise<RemoteResult<{ readonly accepted: boolean }>>
+}
+
+/** One row of `session/list`. */
+export interface RemoteSessionSummary {
+  readonly sessionId: string
+  readonly cwd?: string
+  readonly updatedAt?: number
+  readonly blank?: boolean
+  readonly agentAvailable?: boolean
+  readonly running?: boolean
+  readonly parentSessionId?: string
+  readonly origin?: 'subagent'
+  readonly projections?: {
+    readonly kind: 'cached' | 'sequenced'
+    readonly asOfSeq: number
+    readonly values: {
+      readonly title?: string | null
+      readonly agentPreset?: string | null
+      readonly modelSelection?: ModelSelectionProjection
+      readonly sessionListMetadata?: { readonly blank: boolean; readonly lastPromptAt: number | null }
+    }
+  }
+}
+
+/** Frames of `session/follow`. */
+type FollowFrame =
+  | {
+      readonly type: 'snapshot'
+      readonly header: { readonly id: string; readonly cwd?: string; readonly agentPreset?: string }
+      readonly cursor: number
+      readonly records: ReadonlyArray<{ readonly type: 'event'; readonly event: unknown }>
+      readonly hasMore: boolean
+    }
+  | { readonly type: 'event'; readonly event: unknown }
+  | { readonly type: 'assistant-stream'; readonly frame: unknown }
+
+export interface RemoteSessionHandle {
+  readonly session: AgentSession & { readonly status: AgentSessionStatus }
+  /** The route the session runs on (its recorded choice, else the Host's
+   *  deployment default) — the channel's model display and `/model` marker. */
+  readonly route: { readonly provider: string; readonly model: string }
+  /** The preset the Host composed this session from, when it records one. */
+  readonly agentPreset?: string
+  close(): Promise<void>
+}
+
+const EMPTY_CAPABILITIES: SessionCapabilities = { native: {} }
+
+/** One block of a prompt, as `session/prompt` accepts it. Inline base64 is the
+ *  image path the Host documents: no upload round trip for a pasted bitmap. */
+export type PromptContent =
+  | { readonly type: 'text'; readonly text: string }
+  | { readonly type: 'image'; readonly mediaType: string; readonly data: string; readonly name?: string }
+  | { readonly type: 'file'; readonly receiptId: string }
+
+/** What the Host accepts for one message's images (its own prompt intake). */
+const REMOTE_IMAGE_LIMITS: ImageLimitsView = Object.freeze({
+  mediaTypes: Object.freeze(['image/png', 'image/jpeg', 'image/webp', 'image/gif']),
+  maxImageBytes: 10 * 1024 * 1024,
+  maxImagesPerMessage: 20,
+  maxMessageImageBytes: 30 * 1024 * 1024,
+  maxImageDimension: 8000,
+  maxImagePixels: 40_000_000,
+})
+
+/** What one open session needs from the connection beyond the transport. */
+export interface RemoteSessionDeps {
+  /** The mounted client Remote service. */
+  readonly remote: unknown
+  /** The connection's live-control projection fold. */
+  readonly projections: RemoteProjections
+  /** The connection's model catalog reader. */
+  readonly catalog: RemoteCatalog
+  /** The connection's approval router. */
+  readonly approvals: RemoteApprovals
+}
+
+/**
+ * Open one host session and wait for its opening snapshot.
+ * @param deps - the connection pieces every session shares.
+ * @param sessionId - host session id.
+ * @returns the session handle; the snapshot is already translated into
+ *   `history()`.
+ */
+export async function openRemoteSession(deps: RemoteSessionDeps, sessionId: string): Promise<RemoteSessionHandle> {
+  const { projections, catalog } = deps
+  const sessions = (deps.remote as unknown as { readonly session: SessionRemote }).session
+  // `assistantStream` is the Host's opt-in for the per-token frames: the
+  // durable log alone carries only settlements, which is why a remote turn
+  // used to appear in one piece.
+  const stream = sessions.follow({ address: { kind: 'session', sessionId }, maxMessages: 200, assistantStream: true })
+  const iterator = stream[Symbol.asyncIterator]()
+
+  // Replayed image blocks carry a durable reference, never inline bytes: the
+  // reader resolves it through `session/attachment`, the Host's own
+  // authorization-scoped reader for images proven reachable from this log.
+  const translator = createDshTranslator({
+    tools: () => undefined,
+    scope: () => undefined,
+    attachments: () => ({
+      readImage: async (attachment: { readonly attachmentId: string }, signal?: AbortSignal) => {
+        const result = await sessions.attachment({ sessionId, attachmentId: String(attachment.attachmentId) })
+        if (!result.ok || result.value === undefined) {
+          throw new Error(`remote: session/attachment failed: ${result.error?.message ?? 'unknown error'}`)
+        }
+        if (signal?.aborted === true) throw new Error('remote: image read aborted')
+        return { data: new Uint8Array(Buffer.from(result.value.data, 'base64')) }
+      },
+    }),
+  })
+  const listeners = new Set<(batch: readonly AgentEvent[], meta: AgentEventMeta) => void>()
+  let history: readonly AgentEvent[] = []
+  let cursor = 0
+  let status: AgentSessionStatus = 'starting'
+  /** Ids handed to `session/prompt` that the Host has not echoed yet. The
+   *  channel retires a pending preview only on `pending.changed`, and the Host
+   *  reports the claim as the `user/message` carrying our own requestId. */
+  const awaiting = new Set<string>()
+  let cwd = ''
+  let closed = false
+
+  const emit = (batch: readonly AgentEvent[], meta: AgentEventMeta): void => {
+    if (batch.length === 0 && meta.wake === undefined) return
+    for (const listener of listeners) listener(batch, meta)
+  }
+
+  const opening = await iterator.next()
+  if (opening.done === true || opening.value.type !== 'snapshot') {
+    await iterator.return?.()
+    throw new Error(`remote: session ${sessionId} did not open with a snapshot`)
+  }
+  const snapshot = opening.value
+  cwd = snapshot.header.cwd ?? ''
+  cursor = snapshot.cursor
+  history = translator.translateReplay(snapshot.records.map((record) => record.event as SessionEvent))
+  status = 'idle'
+
+  // The durable selection and every other live projection come from the
+  // connection's control fold: `session/follow`'s snapshot carries the log
+  // only, never projections. A Session that never ran a turn records no
+  // selection, and the Host then serves it the deployment default — which is
+  // what the catalog reports, so this is the same fact, not a stand-in.
+  const { default: deploymentDefault } = await catalog.read()
+  const projected = (): { readonly provider: string; readonly model: string; readonly reasoningEffort?: string } | undefined => {
+    const projection = projections.get<ModelSelectionProjection>(sessionId, 'modelSelection')
+    return projection?.next ?? projection?.lastUsed ?? undefined
+  }
+  // `session/selectModel` returns before the control fold publishes the new
+  // selection, so the readouts would lag by a round trip. Keep the route this
+  // client just wrote until the fold reports it (or another client moves it).
+  let routeOverride: { readonly provider: string; readonly model: string; readonly reasoningEffort?: string } | undefined
+  let routeBeforeWrite: { readonly provider: string; readonly model: string } | undefined
+  const selection = (): { readonly provider: string; readonly model: string; readonly reasoningEffort?: string } =>
+    routeOverride ?? projected() ?? deploymentDefault
+  const noteWrite = (route: { readonly provider: string; readonly model: string; readonly reasoningEffort?: string }): void => {
+    routeBeforeWrite = projected()
+    routeOverride = route
+  }
+  const unregisterRoute = projections.subscribe(sessionId, () => {
+    if (routeOverride === undefined) return
+    const now = projected()
+    const adopted = now !== undefined && now.provider === routeOverride.provider && now.model === routeOverride.model
+    const untouched = (now?.provider ?? '') === (routeBeforeWrite?.provider ?? '')
+      && (now?.model ?? '') === (routeBeforeWrite?.model ?? '')
+    // The fold caught up with our write, or somebody else moved the route:
+    // either way the Host's own record becomes authoritative again.
+    if (adopted || (now !== undefined && !untouched)) routeOverride = undefined
+  })
+
+  // Approvals: the Host asks through the forwarded `approval/request`
+  // waterfall; this session parks one ask at a time in the channel's shared
+  // permission panel and answers the Host with the user's verdict. The
+  // protocol's only grant is "once", so the panel is told exactly that.
+  const approvalOptions: readonly PermissionOptionView[] = [
+    { id: 'allow-once', kind: 'allow-once' },
+    { id: 'reject', kind: 'reject' },
+  ]
+  const parkedApprovals = new Map<string, { readonly view: PermissionRequestView; settle(outcome: ApprovalOutcome): void }>()
+  let approvalSeq = 0
+  const settleApproval = (requestId: string, outcome: ApprovalOutcome): void => {
+    const parked = parkedApprovals.get(requestId)
+    if (parked === undefined) return
+    parkedApprovals.delete(requestId)
+    parked.settle(outcome)
+  }
+  const unregisterApprovals = deps.approvals.register(sessionId, (ask) => {
+    approvalSeq += 1
+    const requestId = `approval:${sessionId}:${approvalSeq}`
+    const view: PermissionRequestView = {
+      requestId,
+      toolName: ask.toolName,
+      ...(ask.callId === undefined ? {} : { callId: ask.callId }),
+      ...(ask.reason === undefined ? {} : { reason: ask.reason }),
+      options: approvalOptions,
+    }
+    return new Promise<ApprovalOutcome>((resolve) => {
+      const settle = (outcome: ApprovalOutcome): void => {
+        ask.signal?.removeEventListener('abort', onAbort)
+        resolve(outcome)
+      }
+      const onAbort = (): void => {
+        parkedApprovals.delete(requestId)
+        emit([{ type: 'permission.settled', requestId, outcome: 'cancelled' }], { replay: false })
+        resolve('cancelled')
+      }
+      parkedApprovals.set(requestId, { view, settle })
+      if (ask.signal !== undefined) {
+        if (ask.signal.aborted) {
+          onAbort()
+          return
+        }
+        ask.signal.addEventListener('abort', onAbort, { once: true })
+      }
+      emit([{ type: 'permission.request', request: view }], { replay: false })
+    })
+  })
+
+  // Ask-user: same waterfall transport as approvals, answered through the
+  // channel's shared question panel. The panel identifies a question by its
+  // position in the batch (`QuestionAnswers` is ordered), so each answer is
+  // re-keyed from the Host's question ids here.
+  const parkedQuestions = new Map<string, {
+    readonly view: QuestionRequestView
+    readonly ask: { readonly questions: readonly { readonly id: string; readonly question: string; readonly detail?: string; readonly header?: string; readonly options?: readonly { readonly label: string; readonly description?: string }[]; readonly multiSelect?: boolean }[] }
+    readonly settle: (answer: RemoteQuestionAnswer) => void
+    readonly withdraw: () => void
+  }>()
+  let questionSeq = 0
+  const unregisterQuestions = deps.approvals.registerQuestions(sessionId, (ask) => {
+    questionSeq += 1
+    const requestId = `question:${sessionId}:${questionSeq}`
+    const view: QuestionRequestView = {
+      requestId,
+      ...(ask.wait === undefined ? {} : { callId: String(ask.wait.callId) }),
+      questions: ask.questions.map((item) => ({
+        question: item.question,
+        ...(item.header === undefined ? {} : { header: item.header }),
+        ...(item.detail === undefined ? {} : { detail: item.detail }),
+        options: (item.options ?? []).map((option) => ({
+          label: option.label,
+          ...(option.description === undefined ? {} : { description: option.description }),
+        })),
+        ...(item.multiSelect === undefined ? {} : { multiSelect: item.multiSelect }),
+      })),
+    }
+    return new Promise<RemoteQuestionAnswer>((resolve) => {
+      const settle = (answer: RemoteQuestionAnswer): void => {
+        ask.signal?.removeEventListener('abort', onAbort)
+        resolve(answer)
+      }
+      const onAbort = (): void => {
+        parkedQuestions.delete(requestId)
+        emit([{ type: 'question.settled', requestId }], { replay: false })
+        resolve({ answers: [] })
+      }
+      parkedQuestions.set(requestId, { view, ask, settle, withdraw: onAbort })
+      if (ask.signal !== undefined) {
+        if (ask.signal.aborted) {
+          onAbort()
+          return
+        }
+        ask.signal.addEventListener('abort', onAbort, { once: true })
+      }
+      emit([{ type: 'question.request', request: view }], { replay: false })
+    })
+  })
+
+  const debug = process.env.DSH_TUI_REMOTE_DEBUG === '1'
+  if (debug) process.stderr.write(`remote: follow ${sessionId} opened cursor=${cursor} records=${snapshot.records.length}\n`)
+  const pump = (async () => {
+    try {
+      for (;;) {
+        const next = await iterator.next()
+        if (next.done === true) break
+        const frame = next.value
+        if (debug) process.stderr.write(`remote: frame ${frame.type}\n`)
+        if (frame.type === 'event') {
+          const event = frame.event as SessionEvent
+          cursor = Math.max(cursor, event.seq)
+          if (event.type === 'turn/start') status = 'running'
+          if (event.type === 'turn/end') status = 'idle'
+          const translated: AgentEvent[] = [...translator.translateEvent(event)]
+          // The Host keeps its own message id and files our requestId under
+          // `source.rpcId` — that is the id the channel tracks the preview by.
+          const echoed = event.type === 'user/message'
+            ? (event.data as { source?: { rpcId?: string } }).source?.rpcId
+            : undefined
+          if (echoed !== undefined && awaiting.delete(echoed)) {
+            if (debug) process.stderr.write(`remote: claim ${echoed}\n`)
+            translated.push({ type: 'pending.changed', items: [], claimed: [echoed] })
+          } else if (echoed !== undefined && debug) {
+            process.stderr.write(`remote: unmatched echo rpcId=${echoed} awaiting=[${[...awaiting].join(',')}]\n`)
+          }
+          emit(translated, { replay: false })
+        } else if (frame.type === 'assistant-stream') {
+          emit(translator.translateFrame(frame.frame as AssistantStreamFrame), { replay: false, wake: 'frame' })
+        }
+      }
+    } catch (error) {
+      if (!closed && process.env.DSH_TUI_DEBUG === '1') {
+        process.stderr.write(`dsh-tui remote: follow ${sessionId} failed: ${String(error)}\n`)
+      }
+    } finally {
+      if (!closed) status = 'disposed'
+    }
+  })()
+
+  /**
+   * The inline image blocks of one message, checked against the same limits
+   * the composer staged them under. A refusal throws a sentence the user sees;
+   * a message never goes out silently missing an image.
+   */
+  const imageBlocks = async (images: readonly ImageRef[]): Promise<PromptContent[]> => {
+    if (images.length === 0) return []
+    if (images.length > REMOTE_IMAGE_LIMITS.maxImagesPerMessage) {
+      throw new Error(`remote: at most ${String(REMOTE_IMAGE_LIMITS.maxImagesPerMessage)} images per message`)
+    }
+    const blocks: PromptContent[] = []
+    let total = 0
+    for (const image of images) {
+      const label = image.name ?? image.id
+      if (image.mediaType === undefined || !REMOTE_IMAGE_LIMITS.mediaTypes.includes(image.mediaType)) {
+        throw new Error(`remote: image "${label}" has an unsupported type (${image.mediaType ?? 'unknown'})`)
+      }
+      const data = await image.read()
+      if (data.byteLength > REMOTE_IMAGE_LIMITS.maxImageBytes) {
+        throw new Error(`remote: image "${label}" is larger than ${String(REMOTE_IMAGE_LIMITS.maxImageBytes / (1024 * 1024))} MB`)
+      }
+      total += data.byteLength
+      if (total > REMOTE_IMAGE_LIMITS.maxMessageImageBytes) {
+        throw new Error(`remote: the message's images exceed ${String(REMOTE_IMAGE_LIMITS.maxMessageImageBytes / (1024 * 1024))} MB`)
+      }
+      blocks.push({
+        type: 'image',
+        mediaType: image.mediaType,
+        data: Buffer.from(data.buffer, data.byteOffset, data.byteLength).toString('base64'),
+        ...(image.name === undefined ? {} : { name: image.name }),
+      })
+    }
+    return blocks
+  }
+
+  const ref: AgentSessionRef = { backendId: 'dsh', sessionId }
+  const session: AgentSession = {
+    ref,
+    get cwd() {
+      return cwd
+    },
+    get status() {
+      return status
+    },
+    // `/model` and `/effort` read the host's catalog and write through the
+    // host: the choice is Session-local, the roster is process-level.
+    capabilities: {
+      native: {},
+      // Compaction runs on the Host, through its own `/compact` command. The
+      // channel routes `/compact` by this capability's presence, so declaring it
+      // is what makes the command available at all in a remote session.
+      compact: {
+        async run() {
+          const api = (deps.remote as unknown as {
+            commands?: { execute(sessionId: string, line: string, images: readonly never[]): Promise<{ ok: boolean; error?: { message?: string } }> }
+          }).commands
+          if (api === undefined) throw new Error('remote: the host did not mount its command registry')
+          const result = await api.execute(sessionId, '/compact', [])
+          if (!result.ok) throw new Error(`remote: /compact failed: ${result.error?.message ?? 'unknown error'}`)
+        },
+      },
+      questions: {
+        respond(requestId, answers) {
+          const parked = parkedQuestions.get(requestId)
+          if (parked === undefined) return
+          parkedQuestions.delete(requestId)
+          // The panel answers by position; the Host wants its own question ids.
+          parked.settle({
+            answers: parked.ask.questions.map((item, index) => ({
+              id: item.id,
+              selected: answers.answers[index]?.selected ?? [],
+              ...(answers.answers[index]?.custom === undefined ? {} : { custom: answers.answers[index]?.custom }),
+            })),
+          })
+          emit([{ type: 'question.settled', requestId }], { replay: false })
+        },
+        cancel(requestId) {
+          const parked = parkedQuestions.get(requestId)
+          if (parked === undefined) return
+          parkedQuestions.delete(requestId)
+          parked.withdraw()
+        },
+      },
+      permissions: {
+        pending: () => [...parkedApprovals.values()].map((parked) => parked.view),
+        respond(requestId, decision) {
+          // `allow-always` cannot widen a protocol whose only grant is once;
+          // narrowing it to a single grant keeps the answer honest, while
+          // refusing it outright would leave the Host waiting.
+          const outcome: ApprovalOutcome = decision.kind === 'reject' ? 'rejected' : 'allowed-once'
+          const parked = parkedApprovals.get(requestId)
+          if (parked === undefined) return
+          parked.settle(outcome)
+          parkedApprovals.delete(requestId)
+          const settled: PermissionOutcome = outcome === 'rejected' ? 'rejected' : 'allow-once'
+          emit([{ type: 'permission.settled', requestId, outcome: settled }], { replay: false })
+        },
+      },
+      models: {
+        list: async () => {
+          const value = await catalog.read()
+          return value.groups.flatMap((group) =>
+            group.models.map((row) => ({
+              provider: group.id,
+              id: row.id,
+              label: row.name,
+              ...(row.description === undefined ? {} : { description: row.description }),
+            })),
+          )
+        },
+        current: (): ModelRef => {
+          const live = selection()
+          return { provider: live.provider, model: live.model }
+        },
+        set: async (target): Promise<ModelSwitchOutcome> => {
+          // Without a provider the channel means "the one this session is on".
+          const provider = target.provider ?? selection().provider ?? deploymentDefault.provider
+          const result = await sessions.selectModel({ sessionId, provider, model: target.model })
+          if (!result.ok) return { kind: 'refused', reason: result.error?.message ?? 'host refused the model' }
+          // The Host resolves the route (it may normalise the provider) and
+          // records it for the next request. Announce it like any other backend
+          // so the footer repaints now rather than after the next request
+          // header lands in the durable log.
+          const selected = result.value?.selected
+          const route = { provider: selected?.provider ?? provider, model: selected?.model ?? target.model }
+          noteWrite(route)
+          emit([{ type: 'model.changed', model: route.model, provider: route.provider, source: 'user' }], { replay: false })
+          return { kind: 'switched' }
+        },
+      },
+      // `/fork`: the Host copies the exact prefix; the anchor the channel passes
+      // is the durable seq of the picked user message (the translator's
+      // `user.message.anchor`), which is exactly what `atSeq` wants.
+      fork: {
+        async fork(anchor, title): Promise<AgentSessionRef> {
+          const atSeq = anchor === undefined ? undefined : Number(anchor)
+          if (atSeq !== undefined && !Number.isSafeInteger(atSeq)) {
+            throw new Error(`remote: cannot fork at anchor "${String(anchor)}" — the Host needs a durable seq`)
+          }
+          const result = await sessions.fork({ sessionId, ...(atSeq === undefined ? {} : { atSeq }) })
+          if (!result.ok || result.value === undefined) {
+            throw new Error(`remote: session/fork failed: ${result.error?.message ?? 'unknown error'}`)
+          }
+          const forked = result.value.sessionId
+          // The RPC carries no title; a named fork gets it from the rename the
+          // Host already exposes instead of being silently left unnamed.
+          if (title !== undefined && title !== '') {
+            const renamed = await sessions.rename({ sessionId: forked, title })
+            if (!renamed.ok) {
+              throw new Error(`remote: forked ${forked} but naming it failed: ${renamed.error?.message ?? 'unknown error'}`)
+            }
+          }
+          return { backendId: 'dsh', sessionId: forked }
+        },
+      },
+      // `/context`: the Host's own token accounting, read from the control
+      // fold. It is the same pair the status line shows (pressure + window),
+      // plus the system/tools/messages split when one is recorded.
+      context: {
+        usage: async () => {
+          const pressure = projections.get<{ pressureTokens?: number; projectedTokens?: number; contextWindow?: number }>(sessionId, 'contextPressure')
+          const used = pressure?.projectedTokens ?? pressure?.pressureTokens
+          if (used === undefined) throw new Error('remote: the host has recorded no request for this session yet')
+          const breakdown = projections.get<{ systemTokens: number; toolsTokens: number; messageTokens: number }>(sessionId, 'contextBreakdown')
+          return {
+            used,
+            ...(pressure?.contextWindow === undefined ? {} : { max: pressure.contextWindow }),
+            categories: breakdown === undefined
+              ? []
+              : [
+                  { name: 'System', tokens: breakdown.systemTokens, kind: 'used' },
+                  { name: 'Tools', tokens: breakdown.toolsTokens, kind: 'used' },
+                  { name: 'Messages', tokens: breakdown.messageTokens, kind: 'used' },
+                ],
+          }
+        },
+      },
+      // The Host takes images inline in the prompt; the channel stages pasted
+      // and dropped bitmaps under these limits instead of a kernel attachments
+      // service (which only exists in-process).
+      images: { limits: REMOTE_IMAGE_LIMITS },
+      effort: {
+        levels: (): readonly EffortOption[] => {
+          const live = selection()
+          const reasoning = catalog.reasoning(live.provider ?? deploymentDefault.provider, live.model)
+          return (reasoning?.efforts ?? []).map((level) => ({ id: level.id, label: level.name }))
+        },
+        forModel: (target) => {
+          const reasoning = catalog.reasoning(target.provider ?? selection().provider ?? deploymentDefault.provider, target.model)
+          return {
+            levels: (reasoning?.efforts ?? []).map((level) => ({ id: level.id, label: level.name })),
+            ...(reasoning?.defaultEffort === undefined ? {} : { defaultEffort: reasoning.defaultEffort }),
+          }
+        },
+        current: () => selection().reasoningEffort,
+        set: async (id) => {
+          const live = selection()
+          const result = await sessions.selectModel({
+            sessionId,
+            provider: live.provider,
+            model: live.model,
+            ...(id === null ? {} : { reasoningEffort: id }),
+          })
+          if (!result.ok) throw new Error(`remote: session/selectModel failed: ${result.error?.message ?? 'unknown error'}`)
+          const selected = result.value?.selected
+          noteWrite({
+            provider: selected?.provider ?? live.provider,
+            model: selected?.model ?? live.model,
+            ...(selected?.reasoningEffort === undefined ? {} : { reasoningEffort: selected.reasoningEffort }),
+          })
+          // Same reason as `model.changed` above: the footer's effort readout
+          // is channel state, and the Host records the tier without an event.
+          emit([{ type: 'effort.changed', effort: selected?.reasoningEffort ?? id }], { replay: false })
+        },
+      },
+    },
+    async history() {
+      return history
+    },
+    subscribe(listener) {
+      listeners.add(listener)
+      return () => listeners.delete(listener)
+    },
+    async submit(input: AgentInput, placement: SubmitPlacement) {
+      if (debug) process.stderr.write(`remote: submit ${placement} text=${JSON.stringify(input.text)} id=${input.clientMessageId}\n`)
+      const result = await sessions.prompt({
+        requestId: input.clientMessageId,
+        sessionId,
+        // The host owns turn/queue semantics: `steer` joins the running turn,
+        // everything else queues (the channel maps its four placements onto
+        // these two).
+        mode: placement === 'steer' ? 'steer' : 'queue',
+        content: [
+          { type: 'text', text: input.text },
+          ...await imageBlocks(input.images ?? []),
+        ],
+      })
+      if (debug) process.stderr.write(`remote: submit result ok=${result.ok} err=${result.error?.message ?? ''}\n`)
+      if (!result.ok) return { accepted: false, reason: result.error?.message ?? 'host rejected the prompt' }
+      // The Host accepted the prompt: it owns the message from here on (it is
+      // durably queued and will be projected back). Retire the local preview now
+      // instead of waiting for an echo — the wire carries our requestId under
+      // `source.rpcId`, and a mismatch there leaves the preview stuck forever.
+      awaiting.delete(input.clientMessageId)
+      emit([{ type: 'pending.changed', items: [], claimed: [input.clientMessageId] }], { replay: false })
+      return { accepted: true }
+    },
+    async cancel(_cause: CancelCause): Promise<CancelReceipt> {
+      const result = await sessions.cancel({ sessionId })
+      return { stillQueued: [], outcome: result.ok ? 'confirmed' : 'failed' }
+    },
+    async dispose() {
+      if (closed) return
+      closed = true
+      status = 'disposed'
+      for (const requestId of [...parkedApprovals.keys()]) settleApproval(requestId, 'cancelled')
+      for (const parked of [...parkedQuestions.values()]) parked.withdraw()
+      parkedQuestions.clear()
+      unregisterApprovals()
+      unregisterQuestions()
+      unregisterRoute()
+      listeners.clear()
+      await iterator.return?.()
+      await pump
+    },
+  }
+
+  const live = selection()
+  return {
+    session,
+    route: { provider: live.provider, model: live.model },
+    ...(snapshot.header.agentPreset === undefined ? {} : { agentPreset: snapshot.header.agentPreset }),
+    async close() {
+      await session.dispose()
+    },
+  }
+}
+
+/** Create (or reuse a blank) host session. */
+export async function createRemoteSession(remote: unknown, cwd: string): Promise<string> {
+  const result = await (remote as unknown as { readonly session: SessionRemote }).session.create({ cwd })
+  if (!result.ok || result.value === undefined) {
+    throw new Error(`remote: session/create failed: ${result.error?.message ?? 'unknown error'}`)
+  }
+  return result.value.sessionId
+}
+
+/** Send one text prompt to a host session (probe path; the TUI uses submit). */
+export async function promptRemoteSession(remote: unknown, sessionId: string, text: string): Promise<void> {
+  const result = await (remote as unknown as { readonly session: SessionRemote }).session.prompt({
+    requestId: crypto.randomUUID(),
+    sessionId,
+    mode: 'queue',
+    content: [{ type: 'text', text }],
+  })
+  if (!result.ok) throw new Error(`remote: session/prompt failed: ${result.error?.message ?? 'unknown error'}`)
+}
+
+/** Cancel a host session's running turn (probe path; the TUI uses cancel). */
+export async function cancelRemoteSession(remote: unknown, sessionId: string): Promise<boolean> {
+  const result = await (remote as unknown as { readonly session: SessionRemote }).session.cancel({ sessionId })
+  return result.ok
+}
+
+/** Rename one host session. */
+export async function renameRemoteSession(remote: unknown, sessionId: string, title: string): Promise<void> {
+  const result = await (remote as unknown as { readonly session: SessionRemote }).session.rename({ sessionId, title })
+  if (!result.ok) throw new Error(`remote: session/rename failed: ${result.error?.message ?? 'unknown error'}`)
+}
+
+/** List the host's sessions. */
+export async function listRemoteSessions(remote: unknown): Promise<readonly RemoteSessionSummary[]> {
+  const result = await (remote as unknown as { readonly session: SessionRemote }).session.list({})
+  if (!result.ok || result.value === undefined) {
+    throw new Error(`remote: session/list failed: ${result.error?.message ?? 'unknown error'}`)
+  }
+  return result.value.items
+}
