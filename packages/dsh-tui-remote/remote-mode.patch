+/**
+ * The Host's interactive waterfalls (approval, ask-user) over the Remote Event
+ * channel.
+ *
+ * The Host answers approvals through a scoped Cordis waterfall
+ * (`approval/request`); the application forwards it to owner clients, and the
+ * client-side Gateway dispatches it to `$on` listeners **through a client
+ * `agent` context**: `typert.contexts.getClient('agent').resolve(agentId)`
+ * must return a context for the asking Agent or the request never reaches a
+ * listener and the Host falls through to its fail-closed `'unavailable'`.
+ *
+ * So this module owns two halves: the per-session scopes that make dispatch
+ * possible, and the router that hands one ask to the session adapter that
+ * owns it. Requests for Agents this client does not follow are declined with
+ * `next()`, which is the protocol's "no opinion", not a verdict.
+ */
+import type { ClientContext } from './connection.js'
+
+/** The protocol's closed outcome set; `'unavailable'` is the Host's
+ *  fail-closed answer when no answerer claims a request. */
+export type ApprovalOutcome = 'allowed-once' | 'rejected' | 'cancelled' | 'unavailable'
+
+/** One forwarded approval ask, as the Host serialized it. */
+export interface RemoteApprovalAsk {
+  readonly toolName: string
+  readonly callId?: string
+  readonly reason?: string
+  /** Localized presentation copy keyed by locale. */
+  readonly displayReason?: Readonly<Record<string, string>>
+  /** The asking turn's lifetime: aborted means the ask is withdrawn. */
+  readonly signal?: AbortSignal
+}
+
+/** One session's answerer; must resolve — a throw is the Host's `'unavailable'`. */
+export type RemoteApprovalAnswer = (ask: RemoteApprovalAsk) => Promise<ApprovalOutcome>
+
+export interface RemoteApprovals {
+  /** Route the approval asks of one followed Session here; the disposer stops it. */
+  register(sessionId: string, answer: RemoteApprovalAnswer): () => void
+  /** Route the ask-user requests of one followed Session here. */
+  registerQuestions(sessionId: string, respond: RemoteQuestionResponder): () => void
+  /** Resolve every outstanding ask as withdrawn and drop the client scope. */
+  dispose(): void
+}
+
+/** One forwarded ask-user question, as the Host serialized it. */
+export interface RemoteQuestionAsk {
+  readonly questions: readonly RemoteQuestionItem[]
+  /** The tool call the answer belongs to. */
+  readonly wait?: { readonly callId: string; readonly timed?: boolean }
+  readonly signal?: AbortSignal
+}
+
+/** One question of a forwarded ask. */
+export interface RemoteQuestionItem {
+  readonly id: string
+  readonly question: string
+  readonly detail?: string
+  readonly header?: string
+  readonly options?: readonly { readonly label: string; readonly description?: string }[]
+  readonly multiSelect?: boolean
+}
+
+/** The Host's answer vocabulary: one entry per asked question, by id. */
+export interface RemoteQuestionAnswer {
+  readonly answers: readonly { readonly id: string; readonly selected: readonly string[]; readonly custom?: string }[]
+}
+
+/** One session's answerer for an ask-user request. */
+export type RemoteQuestionResponder = (ask: RemoteQuestionAsk) => Promise<RemoteQuestionAnswer>
+
+/** The client Remote Event surface this module uses. */
+interface RemoteEvents {
+  $on(
+    event: 'approval/request',
+    listener: (this: unknown, request: RemoteApprovalAsk, next: () => Promise<ApprovalOutcome>) => Promise<ApprovalOutcome | unknown>,
+  ): () => void
+  $on(
+    event: 'user-questions/request',
+    listener: (this: unknown, request: RemoteQuestionAsk, next: () => Promise<RemoteQuestionAnswer>) => Promise<RemoteQuestionAnswer | unknown>,
+  ): () => void
+}
+
+/** The session id riding on a client scope created here. */
+interface SessionScope extends ClientContext {
+  readonly dshRemoteSessionId?: string
+}
+
+/** The Typert client context registry this module writes to. */
+interface TypertContexts {
+  registerClient(
+    key: 'agent',
+    adapter: {
+      identity(candidate: unknown): string | undefined
+      resolve(sessionId: string): unknown
+    },
+  ): () => void
+}
+
+/**
+ * Install the client `agent` context and the approval router.
+ * @param ctx - the client root the connection mounted under.
+ * @param remote - mounted client Remote service.
+ * @returns the router; `register` claims one Session's asks.
+ */
+export function openApprovals(ctx: ClientContext, remote: unknown): RemoteApprovals {
+  const events = remote as unknown as RemoteEvents
+  const typert = ctx.get('typert') as { readonly contexts?: TypertContexts } | undefined
+  const contexts = typert?.contexts
+  if (contexts === undefined) throw new Error('remote: the client context registry is unavailable; approvals cannot be answered')
+
+  const scopes = new Map<string, SessionScope>()
+  const answers = new Map<string, RemoteApprovalAnswer>()
+  const questionResponders = new Map<string, RemoteQuestionResponder>()
+  let disposed = false
+
+  const disposeScope = contexts.registerClient('agent', {
+    identity: (candidate) => (candidate as SessionScope | undefined)?.dshRemoteSessionId,
+    // An Agent this client does not follow resolves to nothing: the Gateway
+    // then skips dispatch and the Host keeps its own chain (fail closed).
+    resolve: (sessionId) => scopes.get(sessionId),
+  })
+
+  const unsubscribeApprovals = events.$on('approval/request', function (request, next) {
+    const sessionId = (this as SessionScope | undefined)?.dshRemoteSessionId
+    const answer = sessionId === undefined ? undefined : answers.get(sessionId)
+    if (answer === undefined) return next()
+    return answer(request)
+  })
+  const unsubscribeQuestions = events.$on('user-questions/request', function (request, next) {
+    const sessionId = (this as SessionScope | undefined)?.dshRemoteSessionId
+    const respond = sessionId === undefined ? undefined : questionResponders.get(sessionId)
+    if (respond === undefined) return next()
+    return respond(request)
+  })
+
+  return {
+    register(sessionId, answer) {
+      if (disposed) throw new Error('remote: the approval router is closed')
+      if (scopes.has(sessionId)) throw new Error(`remote: session ${sessionId} already has an approval answerer`)
+      scopes.set(sessionId, ctx.extend({ dshRemoteSessionId: sessionId }) as SessionScope)
+      answers.set(sessionId, answer)
+      return () => {
+        answers.delete(sessionId)
+        if (!questionResponders.has(sessionId)) scopes.delete(sessionId)
+      }
+    },
+    registerQuestions(sessionId, respond) {
+      if (disposed) throw new Error('remote: the interaction router is closed')
+      if (questionResponders.has(sessionId)) throw new Error(`remote: session ${sessionId} already has a question responder`)
+      if (!scopes.has(sessionId)) scopes.set(sessionId, ctx.extend({ dshRemoteSessionId: sessionId }) as SessionScope)
+      questionResponders.set(sessionId, respond)
+      return () => {
+        questionResponders.delete(sessionId)
+        if (!answers.has(sessionId)) scopes.delete(sessionId)
+      }
+    },
+    dispose() {
+      if (disposed) return
+      disposed = true
+      answers.clear()
+      questionResponders.clear()
+      scopes.clear()
+      unsubscribeApprovals()
+      unsubscribeQuestions()
+      disposeScope()
+    },
+  }
+}
diff --git a/src/dsh-adapter/remote/catalog.ts b/src/dsh-adapter/remote/catalog.ts
new file mode 100644
index 0000000..ff124d8
--- /dev/null
+++ b/src/dsh-adapter/remote/catalog.ts
@@ -0,0 +1,90 @@
+/**
+ * The host's model catalog, read once per connection.
+ *
+ * `session/modelCatalog` is process-level: it describes every routable route
+ * the Host can serve, not one Session's choice. Reading it once and reusing the
+ * answer keeps `/model` and `/effort` synchronous where the channel expects it
+ * (`levels()` has no async seam) while staying honest about a catalog that can
+ * change underneath: `refresh()` re-reads on demand.
+ */
+import type { RemoteResult } from './connection.js'
+
+/** One reasoning tier a route offers. */
+export interface CatalogEffort {
+  readonly id: string
+  readonly name: string
+  readonly description?: string
+}
+
+/** One model row of the host catalog. */
+export interface CatalogModel {
+  readonly id: string
+  readonly name: string
+  readonly description?: string
+  readonly reasoning?: { readonly efforts: readonly CatalogEffort[]; readonly defaultEffort?: string }
+}
+
+/** One provider group of the host catalog. */
+export interface CatalogGroup {
+  readonly id: string
+  readonly name: string
+  readonly models: readonly CatalogModel[]
+}
+
+/** `session/modelCatalog`'s value: every routable model plus provider failures. */
+export interface ModelCatalog {
+  readonly default: { readonly provider: string; readonly model: string; readonly reasoningEffort?: string }
+  readonly routableProviders: readonly string[]
+  readonly groups: readonly CatalogGroup[]
+  readonly failures: readonly { readonly id: string; readonly name: string; readonly message: string }[]
+}
+
+/** The `session/modelCatalog` method this layer calls. */
+export interface CatalogRemote {
+  modelCatalog(): Promise<RemoteResult<ModelCatalog>>
+}
+
+export interface RemoteCatalog {
+  /** The catalog, read on first use. */
+  read(): Promise<ModelCatalog>
+  /** Re-read on the next `read()`. */
+  refresh(): void
+  /** The reasoning tiers a route declares, or undefined when the catalog does
+   *  not know the route yet. */
+  reasoning(provider: string, model: string): { readonly efforts: readonly CatalogEffort[]; readonly defaultEffort?: string } | undefined
+}
+
+/**
+ * Build a catalog reader over one connection.
+ * @param remote - mounted client Remote service.
+ * @returns the reader; `read()` rejects when the host refuses the call.
+ */
+export function createRemoteCatalog(remote: unknown): RemoteCatalog {
+  const session = (remote as unknown as { readonly session: CatalogRemote }).session
+  let cached: ModelCatalog | undefined
+  let inflight: Promise<ModelCatalog> | undefined
+
+  const read = async (): Promise<ModelCatalog> => {
+    if (cached !== undefined) return cached
+    inflight ??= session.modelCatalog().then((result) => {
+      if (!result.ok || result.value === undefined) {
+        throw new Error(`remote: session/modelCatalog failed: ${result.error?.message ?? 'unknown error'}`)
+      }
+      cached = result.value
+      return result.value
+    }).finally(() => {
+      inflight = undefined
+    })
+    return inflight
+  }
+
+  return {
+    read,
+    refresh() {
+      cached = undefined
+    },
+    reasoning(provider, model) {
+      return cached?.groups.find(group => group.id === provider)?.models.find(row => row.id === model)?.reasoning
+    },
+  }
+}
diff --git a/src/dsh-adapter/remote/commands.ts b/src/dsh-adapter/remote/commands.ts
new file mode 100644
index 0000000..1f2cbd6
--- /dev/null
+++ b/src/dsh-adapter/remote/commands.ts
@@ -0,0 +1,99 @@
+/**
+ * The Host's command registry as a client-side `commands` service.
+ *
+ * The TUI gates `/compact`, `/plan` and every other registry command on
+ * `ctx.get('commands')` exposing `find`/`list` (see `channel/capabilities.ts`).
+ * The Host serves the same registry over the wire as `commands/list` and
+ * `commands/execute`; this module mounts that namespace and answers the
+ * synchronous TUI reads from a per-session cache, because the wire calls are
+ * asynchronous and `list()` is called on the render path.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import type { RemoteApi } from './connection.js'
+
+/** One descriptor as the Host reports it (`commands/list` result item). */
+interface RemoteDescriptor {
+  readonly name: string
+  readonly description: string
+  readonly input?: { readonly hint?: string; readonly attachments?: boolean }
+}
+
+/** Composer images in the shape `commands/execute` admits. */
+type RemoteImages = readonly {
+  readonly type: 'image'
+  readonly mediaType: 'image/png' | 'image/jpeg' | 'image/webp' | 'image/gif'
+  readonly data: string
+  readonly name?: string
+}[]
+
+/** The slice of the mounted `commands` namespace this module calls. */
+interface RemoteCommandsApi {
+  list(sessionId: string): Promise<{ ok: boolean; value?: readonly RemoteDescriptor[]; error?: { message?: string } }>
+  execute(
+    sessionId: string,
+    line: string,
+    images: RemoteImages,
+  ): Promise<{ ok: boolean; value?: unknown; error?: { message?: string } }>
+}
+
+/**
+ * The registry is provided **before** `apply()` mounts the channel: the channel
+ * reads `ctx.get('commands')` once, when it binds, so a service registered
+ * later would leave every host command hidden for the whole session.
+ *
+ * State is module-scope because the remote entry is one client per process, and
+ * the binding (host namespace + open session) only becomes known after connect.
+ */
+const descriptors: RemoteDescriptor[] = []
+let bound: RemoteCommandsApi | undefined
+let current: string | undefined
+
+const service = {
+  list: (): readonly RemoteDescriptor[] => descriptors,
+  find: (_agent: unknown, name: string): RemoteDescriptor | undefined =>
+    descriptors.find((descriptor) => descriptor.name === name),
+  execute: async (_agent: unknown, line: string, images: RemoteImages): Promise<unknown> => {
+    if (bound === undefined || current === undefined) return undefined
+    const result = await bound.execute(current, line, images)
+    if (!result.ok) throw new Error(`remote: commands/execute failed: ${result.error?.message ?? 'unknown error'}`)
+    return result.value
+  },
+}
+
+/**
+ * Register the `commands` service on the client root.
+ * @param ctx - the client root the TUI plugin mounts on.
+ */
+export function installRemoteCommands(ctx: Context): void {
+  ctx.provide('commands', service as never)
+}
+
+/**
+ * Point the service at the connected host and prefetch one session's registry.
+ * @param remote - the connected Remote service (must have `dsh-commands` mounted).
+ * @param sessionId - the session whose agent scope the descriptors belong to.
+ */
+export async function bindRemoteCommands(remote: RemoteApi, sessionId: string | undefined): Promise<void> {
+  bound = (remote as unknown as { commands?: RemoteCommandsApi }).commands
+  await refreshRemoteCommands(sessionId)
+}
+
+/**
+ * Reload the descriptor cache for a session.
+ * @param sessionId - the session being opened; `undefined` clears the cache.
+ */
+export async function refreshRemoteCommands(sessionId: string | undefined): Promise<void> {
+  current = sessionId
+  descriptors.length = 0
+  if (bound === undefined || sessionId === undefined) return
+  try {
+    const result = await bound.list(sessionId)
+    // A session switch while the read was in flight must not repopulate the
+    // cache with the previous session's descriptors.
+    if (current !== sessionId) return
+    if (result.ok && result.value !== undefined) descriptors.push(...result.value)
+  } catch {
+    // Leave the cache empty: registry commands then read as unavailable
+    // instead of failing on the render path.
+  }
+}
diff --git a/src/dsh-adapter/remote/connection.ts b/src/dsh-adapter/remote/connection.ts
new file mode 100644
index 0000000..31e70a1
--- /dev/null
+++ b/src/dsh-adapter/remote/connection.ts
@@ -0,0 +1,209 @@
+/**
+ * Remote connection to a running dsh host.
+ *
+ * The TUI normally boots a kernel in-process (`host-entry`). In remote mode it
+ * is a client of an already-running host (the `dsh web` service): the same
+ * Connection transport and generated Remote descriptors the browser uses,
+ * loaded from **the connected installation** so the client half always matches
+ * the server half. Nothing from the host is imported statically; the client
+ * packages are resolved at runtime from the `dsh` on PATH.
+ */
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { findHostDsh } from '../host-dsh.js'
+import { openApprovals, type RemoteApprovals } from './approvals.js'
+import { createRemoteCatalog, type RemoteCatalog } from './catalog.js'
+import { openProjections, type RemoteProjections } from './projections.js'
+
+/** Generated client descriptors mounted on connect. Surfaces land here as
+ *  they are consumed; one entry per `*\/lib/typert.remote-client.js`. */
+const DESCRIPTORS = [
+  'dsh-api-session-controller/lib/typert.remote-client.js',
+  // The Host's command registry: `/compact`, `/plan` and any other host command
+  // resolve through it (the browser mounts the same namespace).
+  'dsh-commands/lib/typert.remote-client.js',
+] as const
+
+/** The subset of the Cordis client root this layer touches. */
+export interface ClientContext {
+  plugin(plugin: unknown): unknown
+  get(name: string): unknown
+  /** Create a scoped child carrying the given context properties. */
+  extend(properties: Record<string, unknown>): ClientContext
+  stop?(): Promise<void> | void
+  connection?: {
+    readonly generation: {
+      getSnapshot(): { readonly host?: { readonly home?: string } } | undefined
+    }
+  }
+}
+
+/** The typed Remote service installed by `@deepseek-ai/dsh-api-gateway/client`. */
+export interface RemoteApi {
+  /**
+   * Register one generated contribution and install its namespace methods.
+   * @param contribution - the default export of a `typert.remote-client` module.
+   * @returns disposer unmounting the namespaces.
+   */
+  $mount(contribution: unknown): Promise<() => Promise<void>>
+}
+
+/** Result envelope every generated Remote method returns. */
+export interface RemoteResult<T> {
+  readonly ok: boolean
+  readonly value?: T
+  readonly error?: { readonly code: string; readonly message: string }
+}
+
+/** A decoded Gateway stream handle (the client's `ClientStreamHandle`). */
+export interface RemoteStream<T> extends AsyncIterable<T> {
+  dispose?(): void
+}
+
+export interface RemoteConnection {
+  readonly ctx: ClientContext
+  readonly remote: RemoteApi
+  /** Host package directory the client half was loaded from. */
+  readonly hostPackageDir: string
+  /** The connection's live-control projection fold (`session/control`). */
+  readonly projections: RemoteProjections
+  /** The connection's model catalog reader (`session/modelCatalog`). */
+  readonly catalog: RemoteCatalog
+  /** The connection's approval router (`approval/request` waterfall). */
+  readonly approvals: RemoteApprovals
+  close(): Promise<void>
+}
+
+interface ConnectionModule {
+  installConnection(
+    ctx: unknown,
+    options: {
+      readonly interactions: 'answer' | 'none'
+      readonly location?: { readonly hostname: string }
+      readonly transport: {
+        readonly streamBaseUrl: string
+        readonly fetch: (input: string | URL, init?: RequestInit) => Promise<Response>
+      }
+    },
+  ): void
+}
+
+interface ContextModule {
+  readonly Context: new () => ClientContext
+}
+
+const sleep = (milliseconds: number) => new Promise<void>((resolve) => setTimeout(resolve, milliseconds))
+
+/**
+ * Create the client root the TUI runs on, using the **connected installation's**
+ * Cordis.
+ *
+ * The bare-root entry must not import `@deepseek-ai/*` statically: a packaged
+ * client has no framework packages of its own (they are the Host's), and the
+ * protocol half has to match the Host that answers. Resolving the same module
+ * the connection resolves keeps one copy on the module graph.
+ * @returns a fresh Cordis root.
+ */
+export async function createClientRoot(): Promise<ClientContext> {
+  const location = findHostDsh()
+  if (!('packageDir' in location)) throw new Error(`remote: ${location.reason}`)
+  const module = await import(pathToFileURL(join(location.packageDir, 'node_modules', '@deepseek-ai/cordis/lib/index.js')).href)
+  const contextModule = module as ContextModule
+  return new contextModule.Context()
+}
+
+async function waitFor<T>(read: () => T | undefined, label: string, timeoutMilliseconds = 10_000): Promise<T> {
+  const deadline = Date.now() + timeoutMilliseconds
+  for (;;) {
+    const value = read()
+    if (value !== undefined) return value
+    if (Date.now() > deadline) throw new Error(`remote: ${label} did not become ready`)
+    await sleep(50)
+  }
+}
+
+/**
+ * Connect to a running host and mount the client Remote namespaces.
+ * @param baseUrl - host base URL, e.g. `http://127.0.0.1:3080`.
+ * @returns the live connection; `close` disposes the owning Cordis root.
+ */
+export async function connectRemote(baseUrl: string, root?: ClientContext): Promise<RemoteConnection> {
+  const location = findHostDsh()
+  if (!('packageDir' in location)) throw new Error(`remote: ${location.reason}`)
+  const nodeModules = join(location.packageDir, 'node_modules')
+  const load = (specifier: string): Promise<unknown> => import(pathToFileURL(join(nodeModules, specifier)).href)
+
+  const modules = await Promise.all([
+    load('@deepseek-ai/cordis/lib/index.js'),
+    load('@deepseek-ai/dsh-client-connection/lib/client.node.js'),
+    load('@deepseek-ai/dsh-api-gateway/lib/client.node.js'),
+    load('@deepseek-ai/dsh-typert-registry/lib/client.node.js'),
+    ...DESCRIPTORS.map((descriptor) => load(`@deepseek-ai/${descriptor}`)),
+  ])
+  const contextModule = modules[0] as ContextModule
+  const connectionModule = modules[1] as ConnectionModule
+  const gatewayModule = modules[2] as { readonly apply: unknown }
+  const typertModule = modules[3] as { readonly apply: unknown }
+  const descriptorModules = modules.slice(4) as Array<{ readonly default?: unknown }>
+
+  const ownsRoot = root === undefined
+  const ctx = root ?? new contextModule.Context()
+  ctx.plugin({
+    name: 'dsh-tui-remote',
+    apply: (scope: unknown) => {
+      connectionModule.installConnection(scope, {
+        interactions: 'answer',
+        location: { hostname: new URL(baseUrl).hostname },
+        transport: {
+          streamBaseUrl: baseUrl,
+          // The Node caller has no document base: every unary RPC needs an
+          // absolute URL or `fetch` rejects the relative path.
+          fetch: (input: string | URL, init?: RequestInit) => fetch(new URL(input, baseUrl), init),
+        },
+      })
+    },
+  })
+  ctx.plugin(typertModule)
+  ctx.plugin(gatewayModule)
+
+  const debug = process.env.DSH_TUI_REMOTE_DEBUG === '1'
+  const note = (line: string): void => {
+    if (debug) process.stderr.write(`remote: ${line}\n`)
+  }
+  note(`loaded client libraries from ${location.packageDir}`)
+
+  const remote = await waitFor(() => ctx.get('remote') as RemoteApi | undefined, 'client Remote service')
+  note('Remote service installed')
+  const mounted: Array<() => Promise<void>> = []
+  for (const module of descriptorModules) {
+    if (module.default === undefined) continue
+    mounted.push(await remote.$mount(module.default))
+  }
+  note(`mounted ${mounted.length} descriptor(s)`)
+  await waitFor(
+    () => (ctx.connection?.generation.getSnapshot() === undefined ? undefined : true),
+    'connection generation',
+  )
+  note('connection generation ready')
+
+  const projections = openProjections(remote)
+  await projections.ready
+  note('projections baseline ready')
+  const catalog = createRemoteCatalog(remote)
+  const approvals = openApprovals(ctx, remote)
+
+  return {
+    ctx,
+    remote,
+    hostPackageDir: location.packageDir,
+    projections,
+    catalog,
+    approvals,
+    async close() {
+      approvals.dispose()
+      for (const dispose of mounted.reverse()) await dispose().catch(() => {})
+      await projections.close()
+      if (ownsRoot) await ctx.stop?.()
+    },
+  }
+}
diff --git a/src/dsh-adapter/remote/entry.ts b/src/dsh-adapter/remote/entry.ts
new file mode 100644
index 0000000..9797121
--- /dev/null
+++ b/src/dsh-adapter/remote/entry.ts
@@ -0,0 +1,24 @@
+/**
+ * Bare-root entry: the TUI as a client of a running host, with no profile
+ * composition at all. The launcher sets DSH_TUI_REMOTE_URL; nothing from the
+ * DSH kernel is imported or booted here.
+ */
+import { installRemoteCommands } from './commands.js'
+import { createClientRoot } from './connection.js'
+import { Config } from '../index.js'
+import { apply } from '../plugin.js'
+import { DSH_BACKEND_ID } from '../../kernelPrefs.js'
+
+const url = process.env.DSH_TUI_REMOTE_URL?.trim()
+if (url === undefined || url === '') {
+  process.stderr.write('dsh-tui: remote entry needs DSH_TUI_REMOTE_URL\n')
+  process.exit(2)
+}
+
+// The root comes from the connected installation, not from this package: a
+// packaged client ships no framework packages of its own.
+const ctx = await createClientRoot() as unknown as Parameters<typeof apply>[0]
+// Before `apply`: the channel captures `ctx.get('commands')` when it binds.
+installRemoteCommands(ctx as never)
+const config = Config({})
+await apply(ctx, config, ctx, { deferBackendOpen: true, entryKernel: DSH_BACKEND_ID, profile: 'remote' })
diff --git a/src/dsh-adapter/remote/probe.ts b/src/dsh-adapter/remote/probe.ts
new file mode 100644
index 0000000..edfcf16
--- /dev/null
+++ b/src/dsh-adapter/remote/probe.ts
@@ -0,0 +1,205 @@
+/**
+ * M1 probe: prove the remote client and the session adapter inside this
+ * package (not from a standalone script), against a running host.
+ *
+ * Usage:
+ *   node --import tsx/esm src/dsh-adapter/remote/probe.ts <baseUrl> list
+ *   node --import tsx/esm src/dsh-adapter/remote/probe.ts <baseUrl> create [cwd]
+ *   node --import tsx/esm src/dsh-adapter/remote/probe.ts <baseUrl> follow <sessionId> [seconds]
+ */
+import { connectRemote } from './connection.js'
+import { cancelRemoteSession, createRemoteSession, listRemoteSessions, openRemoteSession, promptRemoteSession } from './session.js'
+
+const [baseUrl, command, sessionId, seconds] = process.argv.slice(2)
+if (baseUrl === undefined || command === undefined) {
+  process.stderr.write('usage: probe.ts <baseUrl> list|create|follow [arg]\n')
+  process.exit(2)
+}
+
+const connection = await connectRemote(baseUrl)
+process.stderr.write(`[probe] connected host=${connection.hostPackageDir}\n`)
+const deps = { remote: connection.remote, projections: connection.projections, catalog: connection.catalog, approvals: connection.approvals }
+
+if (command === 'list') {
+  const sessions = await listRemoteSessions(connection.remote)
+  process.stderr.write(`[probe] ${sessions.length} session(s)\n`)
+  for (const session of sessions.slice(0, 10)) {
+    process.stderr.write(`  ${session.sessionId} cwd=${session.cwd ?? '?'} title=${JSON.stringify(session.projections?.values.title ?? null)}\n`)
+  }
+} else if (command === 'create') {
+  const created = await createRemoteSession(connection.remote, sessionId ?? process.cwd())
+  process.stderr.write(`[probe] created ${created}\n`)
+} else if (command === 'prompt' && sessionId !== undefined) {
+  await promptRemoteSession(connection.remote, sessionId, seconds ?? 'say hi')
+  process.stderr.write('[probe] prompt accepted\n')
+} else if (command === 'cancel' && sessionId !== undefined) {
+  const ok = await cancelRemoteSession(connection.remote, sessionId)
+  process.stderr.write(`[probe] cancel ok=${ok}\n`)
+} else if (command === 'models') {
+  const catalog = await connection.catalog.read()
+  process.stderr.write(`[probe] default=${catalog.default.provider}/${catalog.default.model} routable=[${catalog.routableProviders.join(',')}] groups=[${catalog.groups.map((g) => `${g.id}:${g.models.length}`).join(',')}] failures=${catalog.failures.length}\n`)
+  for (const group of catalog.groups) {
+    for (const row of group.models) {
+      process.stderr.write(`  ${group.id}/${row.id} "${row.name}" efforts=${row.reasoning?.efforts.map((e) => e.id).join('|') ?? '-'} default=${row.reasoning?.defaultEffort ?? '-'}\n`)
+    }
+  }
+} else if (command === 'capabilities' && sessionId !== undefined) {
+  const handle = await openRemoteSession(deps, sessionId)
+  const capabilities = handle.session.capabilities
+  const models = capabilities.models
+  const effort = capabilities.effort
+  const options = await models?.list() ?? []
+  process.stderr.write(`[probe] models=${options.length} current=${JSON.stringify(models?.current())}\n`)
+  process.stderr.write(`[probe] efforts levels=${JSON.stringify(effort?.levels())} current=${String(effort?.current())}\n`)
+  const live = models?.current()
+  if (live?.provider !== undefined) {
+    process.stderr.write(`[probe] forModel(current)=${JSON.stringify(effort?.forModel?.({ provider: live.provider, model: live.model }))}\n`)
+  }
+  const target = (seconds ?? '').split('/')
+  if (target.length === 2 && target[1] !== '') {
+    const outcome = await models?.set({ provider: target[0], model: target[1] ?? '' })
+    process.stderr.write(`[probe] set ${target[0]}/${target[1]} -> ${JSON.stringify(outcome)}\n`)
+    await new Promise((resolve) => setTimeout(resolve, 600))
+    process.stderr.write(`[probe] after set current=${JSON.stringify(models?.current())} efforts=${JSON.stringify(effort?.levels())} effort=${String(effort?.current())}\n`)
+  }
