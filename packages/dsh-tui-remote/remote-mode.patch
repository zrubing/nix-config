+    if (typed.type !== 'snapshot') break
+    const events = (typed.records ?? []).map(record => record.event).filter((event): event is { type: string, seq?: number, data?: unknown } => event !== undefined)
+    for (const event of events.slice(-14)) {
+      const detail = event.type.startsWith('approval/') || event.type === 'tool/result' ? ` ${JSON.stringify(event.data).slice(0, 220)}` : ''
+      process.stderr.write(`[probe] ${String(event.seq)} ${event.type}${detail}\n`)
+    }
+    break
+  }
+} else if (command === 'proj' && sessionId !== undefined) {
+  const values = connection.projections.values(sessionId)
+  process.stderr.write(`[probe] projection keys=${JSON.stringify(Object.keys(values ?? {}))}\n`)
+  for (const key of ['contextPressure', 'contextBreakdown', 'modelSelection', 'permissions', 'title']) {
+    if (values?.[key] !== undefined) process.stderr.write(`  ${key}=${JSON.stringify(values[key])}\n`)
+  }
+} else if (command === 'rawuser' && sessionId !== undefined) {
+  const sessions = (deps.remote as unknown as { session: { follow(request: unknown): AsyncIterable<unknown> } }).session
+  const stream = sessions.follow({ address: { kind: 'session', sessionId }, maxMessages: 50 })
+  for await (const frame of stream) {
+    const typed = frame as { type?: string, records?: readonly { event?: { type?: string, data?: unknown } }[] }
+    if (typed.type !== 'snapshot') break
+    for (const record of typed.records ?? []) {
+      if (record.event?.type !== 'user/message') continue
+      const data = record.event.data as { content?: unknown }
+      process.stderr.write(`[probe] user/message ${JSON.stringify(data.content)}\n`)
+    }
+    break
+  }
+} else if (command === 'imagecheck' && sessionId !== undefined) {
+  // A 1x1 PNG: enough to prove the Host accepts the inline image block shape
+  // (the turn itself may still fail on the model route).
+  const png = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=='
+  const bytes = new Uint8Array(Buffer.from(png, 'base64'))
+  const handle = await openRemoteSession(deps, sessionId)
+  const limits = handle.session.capabilities.images?.limits
+  process.stderr.write(`[probe] images capability=${limits === undefined ? 'absent' : JSON.stringify(limits)}\n`)
+  const submitted = await handle.session.submit({
+    clientMessageId: crypto.randomUUID(),
+    text: 'Image intake check: one 1x1 PNG attached.',
+    images: [{
+      id: 'probe-1',
+      width: 1,
+      height: 1,
+      name: 'probe.png',
+      mediaType: 'image/png',
+      bytes: bytes.byteLength,
+      read: () => Promise.resolve(bytes),
+    }],
+  }, 'turn')
+  process.stderr.write(`[probe] submit-with-image ${JSON.stringify(submitted)}\n`)
+  await new Promise((resolve) => setTimeout(resolve, 4000))
+  const history = await handle.session.history()
+  const withImage = history
+    .filter((event): event is Extract<typeof event, { type: 'user.message' }> => event.type === 'user.message')
+    .reverse()
+    .find(event => event.images !== undefined && event.images.length > 0)
+  if (withImage === undefined) {
+    process.stderr.write('[probe] no projected user message carries an image\n')
+  } else {
+    const image = withImage.images![0]!
+    process.stderr.write(`[probe] projected image ${JSON.stringify({ id: image.id, mediaType: image.mediaType, width: image.width, height: image.height, bytes: image.bytes, name: image.name })}\n`)
+    const bytes = await image.read()
+    process.stderr.write(`[probe] attachment read ok, ${String(bytes.byteLength)} bytes, png=${String(bytes[0] === 0x89 && bytes[1] === 0x50)}\n`)
+  }
+  await handle.close()
+} else if (command === 'follow' && sessionId !== undefined) {
+  const handle = await openRemoteSession(deps, sessionId)
+  const history = await handle.session.history()
+  process.stderr.write(`[probe] history events=${history.length} cwd=${handle.session.cwd}\n`)
+  const seen: string[] = []
+  handle.session.subscribe((batch, meta) => {
+    for (const event of batch) {
+      seen.push(`${meta.wake ?? 'sync'}:${event.type}`)
+      if (event.type === 'turn.end') process.stderr.write(`[probe] turn.end ${JSON.stringify(event)}\n`)
+    }
+  })
+  await new Promise((resolve) => setTimeout(resolve, Number(seconds ?? '5') * 1000))
+  process.stderr.write(`[probe] live events=${seen.length}: ${seen.slice(0, 12).join(', ')}\n`)
+  await handle.close()
+} else {
+  process.stderr.write('usage: probe.ts <baseUrl> list|create|follow [arg]\n')
+  process.exitCode = 2
+}
+
+await connection.close()
