+++ b/src/dsh-adapter/remote/projections.ts
@@ -0,0 +1,125 @@
+/**
+ * Host-wide live-control projections.
+ *
+ * `session/follow` carries the durable log; it does not carry projections. The
+ * Host publishes them on one process-level stream (`session/control`): a
+ * complete baseline for every live Session, then one replacement frame per
+ * `(sessionId, key)`. Model selection, permissions, titles, todos and the
+ * question queue all live here, so the remote adapter folds this stream once
+ * and every capability reads from the fold.
+ */
+import type { RemoteStream } from './connection.js'
+
+/** One Session's projection values at a cut. */
+export type ProjectionValues = Readonly<Record<string, unknown>>
+
+/** The `session/control` methods this layer calls. */
+export interface ControlRemote {
+  control(): RemoteStream<ControlFrame>
+}
+
+/** Frames of `session/control`. */
+type ControlFrame =
+  | {
+      readonly type: 'baseline'
+      readonly value: {
+        readonly projections: Readonly<Record<string, { readonly asOfSeq: number; readonly values: ProjectionValues }>>
+      }
+    }
+  | { readonly type: 'projection'; readonly sessionId: string; readonly key: string; readonly value: unknown; readonly seq: number }
+
+/** One Session's durable model selection projection. */
+export interface ModelSelectionProjection {
+  readonly lastUsed: { readonly provider: string; readonly model: string; readonly reasoningEffort?: string } | null
+  readonly next: { readonly provider: string; readonly model: string; readonly reasoningEffort?: string } | null
+}
+
+export interface RemoteProjections {
+  /** Wait for the baseline (or the stream's end, whichever comes first). */
+  readonly ready: Promise<void>
+  /** One Session's whole projection block, or undefined before it is known. */
+  values(sessionId: string): ProjectionValues | undefined
+  /** One projection value of one Session. */
+  get<T>(sessionId: string, key: string): T | undefined
+  /** Listen for any change to one Session; the disposer stops listening. */
+  subscribe(sessionId: string, listener: () => void): () => void
+  close(): Promise<void>
+}
+
+/**
+ * Open the host's live-control stream and fold it into a per-Session store.
+ * @param remote - mounted client Remote service.
+ * @returns the projection store; `ready` resolves once the baseline landed.
+ */
+export function openProjections(remote: unknown): RemoteProjections {
+  const control = (remote as unknown as { readonly session: ControlRemote }).session
+  const stream = control.control()
+  const iterator = stream[Symbol.asyncIterator]()
+  const baseline = new Map<string, Map<string, unknown>>()
+  const listeners = new Map<string, Set<() => void>>()
+  let closed = false
+  let settleReady: () => void = () => {}
+  const ready = new Promise<void>((resolve) => { settleReady = resolve })
+
+  const notify = (sessionId: string): void => {
+    for (const listener of listeners.get(sessionId) ?? []) listener()
+  }
+
+  const pump = (async () => {
+    try {
+      for (;;) {
+        const next = await iterator.next()
+        if (next.done === true) break
+        const frame = next.value
+        if (frame.type === 'baseline') {
+          for (const [sessionId, block] of Object.entries(frame.value.projections)) {
+            const values = baseline.get(sessionId) ?? new Map<string, unknown>()
+            for (const [key, value] of Object.entries(block.values)) values.set(key, value)
+            baseline.set(sessionId, values)
+            notify(sessionId)
+          }
+          settleReady()
+        } else {
+          const values = baseline.get(frame.sessionId) ?? new Map<string, unknown>()
+          values.set(frame.key, frame.value)
+          baseline.set(frame.sessionId, values)
+          notify(frame.sessionId)
+        }
+      }
+    } catch {
+      // A dropped stream leaves the last fold in place: the Session's own
+      // follow stream stays authoritative for the log, and a reconnect
+      // reopens both.
+    } finally {
+      settleReady()
+    }
+  })()
+
+  return {
+    ready,
+    values(sessionId) {
+      const values = baseline.get(sessionId)
+      if (values === undefined) return undefined
+      return Object.fromEntries(values)
+    },
+    get<T>(sessionId: string, key: string): T | undefined {
+      return baseline.get(sessionId)?.get(key) as T | undefined
+    },
+    subscribe(sessionId, listener) {
+      const set = listeners.get(sessionId) ?? new Set<() => void>()
+      set.add(listener)
+      listeners.set(sessionId, set)
+      return () => {
+        set.delete(listener)
+        if (set.size === 0) listeners.delete(sessionId)
+      }
+    },
+    async close() {
+      if (closed) return
+      closed = true
+      listeners.clear()
+      await iterator.return?.()
+      await pump
+    },
+  }
+}
