+/**
+ * The Session's route as a record: the shape `session/selectModel` resolves
+ * and returns, and the shape the `agent-default-model` row stores.
+ */
+export interface RouteRecord {
+  readonly provider: string
+  readonly model: string
+  readonly reasoningEffort?: string
+}
+
+/** The `agentDefaultModel` namespace `applySessionRoute` needs. */
+interface AgentDefaultModelRemote {
+  readConfig(): Promise<RemoteResult<RouteRecord | undefined>>
+  editConfig(change: (config: RouteRecord) => RouteRecord): Promise<RemoteResult<unknown>>
+}
+
+/**
+ * Whether the Session already runs on the requested model. The tier is not
+ * compared: the Host records a tier even when nobody chose one, so a launch
+ * that names only the model must not re-write a route that already holds.
+ */
+export function routeHolds(current: RouteRecord | undefined, wanted: RouteRecord): boolean {
+  return current !== undefined && current.provider === wanted.provider && current.model === wanted.model
+}
+
+/**
+ * Install a route on a Session that does not run it — `--model` at startup.
+ *
+ * `session/selectModel` is the Host's only remote entry for this, and it also
+ * saves the selection as the **deployment** default: `agentDefaultModel.saveSelection`
+ * replaces the `agent-default-model` row's whole config, reasoning tier
+ * included. A startup override belongs to this launch alone, so the saved
+ * config is read first and written back afterwards; the tier that default
+ * carries is also what applies when the override names none (the model
+ * catalog reports that tier, not the name's).
+ * @param remote - the mounted client Remote service.
+ * @param sessionId - the Session to install the route on.
+ * @param target - provider, model, and the tier when the launch names one.
+ * @returns the route the Host resolved and recorded.
+ */
+export async function applySessionRoute(
+  remote: unknown,
+  sessionId: string,
+  target: RouteRecord,
+): Promise<RouteRecord> {
+  const sessions = (remote as unknown as { readonly session: SessionRemote }).session
+  const defaults = (remote as unknown as { readonly agentDefaultModel: AgentDefaultModelRemote }).agentDefaultModel
+  const saved = await defaults.readConfig()
+  if (!saved.ok || saved.value === undefined) {
+    throw new Error(`remote: agentDefaultModel/readConfig failed: ${saved.error?.message ?? 'unknown error'}`)
+  }
+  const previous = saved.value
+  const reasoningEffort = target.reasoningEffort ?? previous.reasoningEffort
+  const result = await sessions.selectModel({
+    sessionId,
+    provider: target.provider,
+    model: target.model,
+    ...(reasoningEffort === undefined ? {} : { reasoningEffort }),
+  })
+  if (!result.ok) throw new Error(`remote: session/selectModel failed: ${result.error?.message ?? 'unknown error'}`)
+  const restored = await defaults.editConfig(() => previous)
+  if (!restored.ok) {
+    throw new Error(`remote: the route was installed but the deployment default could not be restored: ${restored.error?.message ?? 'unknown error'}`)
+  }
+  const selected = result.value?.selected
+  return {
+    provider: selected?.provider ?? target.provider,
+    model: selected?.model ?? target.model,
+    ...(selected?.reasoningEffort === undefined ? {} : { reasoningEffort: selected.reasoningEffort }),
+  }
+}
+
