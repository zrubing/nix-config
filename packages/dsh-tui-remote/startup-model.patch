+/**
+ * `<provider>/<model>`, optionally followed by `:<effort>`. The provider is
+ * one path segment (route names carry no `/`); everything after it is the
+ * model id, so gateway-style ids stay intact.
+ * @param raw - the override as written.
+ * @returns the route, or undefined when the string cannot name one.
+ */
+export function parseStartupModel(raw: string): RouteRecord | undefined {
+  const trimmed = raw.trim()
+  const slash = trimmed.indexOf('/')
+  if (slash <= 0) return undefined
+  const rest = trimmed.slice(slash + 1)
+  const colon = rest.lastIndexOf(':')
+  const model = colon === -1 ? rest : rest.slice(0, colon)
+  const effort = colon === -1 ? '' : rest.slice(colon + 1)
+  if (model === '' || (colon !== -1 && effort === '')) return undefined
+  return { provider: trimmed.slice(0, slash), model, ...(effort === '' ? {} : { reasoningEffort: effort }) }
+}
+
+/**
+ * The route handed over in the environment by the remote entry (`--model`).
+ * @returns the route, or undefined when this launch takes the Host's own.
+ */
+export function startupRouteOverride(): RouteRecord | undefined {
+  const provider = process.env.DSH_TUI_STARTUP_PROVIDER?.trim()
+  const model = process.env.DSH_TUI_STARTUP_MODEL?.trim()
+  if (provider === undefined || provider === '' || model === undefined || model === '') return undefined
+  const effort = process.env.DSH_TUI_STARTUP_EFFORT?.trim()
+  return { provider, model, ...(effort === undefined || effort === '' ? {} : { reasoningEffort: effort }) }
+}
