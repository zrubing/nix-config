+/**
+ * Follow the client connection's generation: the connection drops it on a
+ * carrier loss and publishes the next one once a socket is back. That gap is
+ * the only honest source for "reconnecting" — the logical streams reopen on
+ * top of it, so a short blip never surfaces as a stream failure.
+ * @param ctx - the client root the connection mounted on.
+ * @returns the observable link plus the disposer of its subscription.
+ */
+function observeLink(ctx: ClientContext): { readonly link: RemoteLink; dispose(): void } {
+  const generation = ctx.connection?.generation
+  const read = (): RemoteLink['state'] => (generation?.getSnapshot() === undefined ? 'reconnecting' : 'connected')
+  let state = read()
+  const listeners = new Set<(state: RemoteLink['state']) => void>()
+  const publish = (): void => {
+    const next = read()
+    if (next === state) return
+    state = next
+    for (const listener of [...listeners]) listener(state)
+  }
+  const off = generation?.subscribe?.(publish)
+  return {
+    link: {
+      get state() { return state },
+      subscribe(listener) {
+        listeners.add(listener)
+        return () => { listeners.delete(listener) }
+      },
+    },
+    dispose() {
+      off?.()
+      listeners.clear()
+    },
+  }
+}
