+/**
+ * One logical Remote stream that outlives the socket it arrived on.
+ *
+ * A generated stream method (`session/follow`, `session/control`) hands back a
+ * single carrier generation: when its WebSocket dies — the `dsh web` service
+ * restarts, the connection resets — the iterator ends for good. The client then
+ * goes deaf while every unary RPC keeps working, which is how a window can
+ * accept prompts it will never render. `remote.$stream` owns the retry across
+ * generations; this layer gives the reopened generation the meaning the
+ * protocol gives it: one opening baseline, then deltas on top of it.
+ *
+ * Both streams here are baseline-and-delta by construction (`snapshot` /
+ * `baseline` first, then `event` / `projection` frames), so a replacement
+ * generation's baseline is handed to the owner instead of surfacing as a stray
+ * frame the owner would skip.
+ */
+import type { GatewayClientModule, RemoteApi } from './connection.js'
+
+/** What one live stream needs from the connection. */
+export interface LiveStreamHost {
+  /** The mounted client Remote service (owns `$stream`). */
+  readonly remote: RemoteApi
+  /** The client protocol classes loaded from the connected installation. */
+  readonly gateway: GatewayClientModule
+}
+
+/** The owner's half of a baseline-and-delta stream. */
+export interface LiveStreamOptions<Snapshot, Delta> {
+  /** Diagnostic stream name used in protocol failures. */
+  readonly name: string
+  /** Open one carrier generation of this stream. */
+  readonly open: (signal: AbortSignal) => AsyncIterable<Snapshot | Delta>
+  /** Distinguish a generation's opening baseline from its deltas. */
+  readonly isSnapshot: (value: Snapshot | Delta) => value is Snapshot
+  /** Apply a complete baseline: first open, and every replacement generation. */
+  readonly replace: (snapshot: Snapshot) => void
+  /** Apply one delta after its generation's baseline. */
+  readonly update: (delta: Delta) => void
+  /** The stream is over: retries are exhausted or the protocol was violated. */
+  readonly failed: (error: unknown) => void
+}
+
+/** One logical stream: dispose stops it for good. */
+export interface LiveStream {
+  dispose(): Promise<void>
+}
+
+/**
+ * Open the stream now and keep it open across carrier generations.
+ * @param host - the connection's Remote service and protocol classes.
+ * @param options - baseline/delta destinations of the owner.
+ * @returns the running stream; `dispose` is idempotent.
+ */
+export function openLiveStream<Snapshot, Delta>(
+  host: LiveStreamHost,
+  options: LiveStreamOptions<Snapshot, Delta>,
+): LiveStream {
+  const stream = host.remote.$stream<Snapshot | Delta>({
+    name: options.name,
+    open: options.open,
+    // `session/follow` and `session/control` have no terminal frame: a
+    // generation that stops on its own is a lost carrier, and the supervisor
+    // must reopen it against the next connection instead of ending the stream.
+    ended: (accepted) => new host.gateway.RemoteStreamCarrierError(
+      `${options.name} ended${accepted ? '' : ' before its opening baseline'}`,
+    ),
+  })
+  const snapshot = new host.gateway.RemoteSnapshotStream<Snapshot, Delta>(stream, {
+    name: options.name,
+    isSnapshot: options.isSnapshot,
+    replace: options.replace,
+    update: options.update,
+    failed: options.failed,
+  })
+  snapshot.start()
+  return { dispose: () => snapshot.dispose() }
+}
