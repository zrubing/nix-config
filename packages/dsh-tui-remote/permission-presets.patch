+/**
+ * The Host's permission-preset catalog, projected onto the typed `modes`
+ * capability a non-DSH session exposes.
+ *
+ * The TUI's `/permission` picker and Shift+Tab cycle read
+ * `AgentSession.capabilities.modes` on every backend that is not DSH (see
+ * `channel/core/actions.ts` and `capabilities.ts`). A remote Session has no
+ * kernel, so the catalog comes from the Host's process-level
+ * `permissionPresets/catalog`, and the current identity from the live
+ * `session/control` projection.
+ *
+ * This is read + switch only. The switch goes through the official
+ * `/permission <preset>` command (`commands/execute`), so the Host owns the
+ * durable `permission/preset` event and this client never manufactures one.
+ */
+import type { ModeOption, SessionCapabilities } from '../../agent/capabilities.js'
+import { permissionPresetDescription, permissionPresetKeys, permissionPresetLabel } from '../../permissionPresetLabels.js'
+import type { RemoteResult } from './connection.js'
+import type { RemoteProjections } from './projections.js'
+
+/** The derived identity the registry reports when no table entry matches. */
+const CUSTOM_PRESET = 'custom'
+
+/** The experimental preset whose risk gate only `/permission`'s DSH picker has. */
+const AUTO_PRESET = 'auto'
+
+/** One preset as `permissionPresets/catalog` publishes it. */
+export interface PermissionCatalogOption {
+  readonly value: string
+  readonly name: string
+  readonly description?: string
+}
+
+/** The process-level permission roster this client can present. */
+export interface RemotePermissionCatalog {
+  readonly options: readonly PermissionCatalogOption[]
+}
+
+/** The one Remote namespace this module consumes. */
+interface PermissionPresetsRemote {
+  catalog(): Promise<RemoteResult<{ readonly options: readonly PermissionCatalogOption[] }>>
+}
+
+/**
+ * Read the Host's selectable permission presets once per connection.
+ *
+ * `custom` is the derived non-preset state, never a switchable identity; `auto`
+ * is excluded because its session-scoped risk confirmation is implemented only
+ * by the DSH `/permission` preset picker, and presenting it as an ordinary
+ * backend mode would bypass that gate.
+ * @param remote - the connected Remote service.
+ * @returns the catalog, or undefined when the Host mounts no usable table.
+ */
+export async function readRemotePermissionCatalog(remote: unknown): Promise<RemotePermissionCatalog | undefined> {
+  const service = (remote as { readonly permissionPresets?: PermissionPresetsRemote }).permissionPresets
+  if (service === undefined) return undefined
+  try {
+    const result = await service.catalog()
+    if (!result.ok || result.value === undefined) return undefined
+    const options = result.value.options.filter(option => option.value !== CUSTOM_PRESET && option.value !== AUTO_PRESET)
+    return options.length === 0 ? undefined : { options }
+  } catch {
+    // An older Host without the namespace keeps `/permission` unavailable;
+    // the rest of the connection is unaffected.
+    return undefined
+  }
+}
+
+/** The current identity the Host projects for one Session. */
+function currentPreset(projections: RemoteProjections, sessionId: string): string {
+  const projected = projections.get<{ readonly currentValue?: unknown }>(sessionId, 'permissions')
+  return typeof projected?.currentValue === 'string' ? projected.currentValue : ''
+}
+
+/**
+ * Build the Session's `modes` capability from the Host catalog.
+ *
+ * `set` waits for the projection to confirm the switch instead of trusting the
+ * command's return value alone: the durable identity is what the picker and
+ * the next turn actually read.
+ * @param deps - catalog, projection fold, Session id and the command writer.
+ * @returns the typed capability; the caller omits `modes` when the Host has no
+ *   catalog, which keeps `/permission` out of the command list.
+ */
+export function createRemotePermissionModes(deps: {
+  readonly catalog: RemotePermissionCatalog
+  readonly projections: RemoteProjections
+  readonly sessionId: string
+  execute(line: string): Promise<RemoteResult<unknown>>
+}): NonNullable<SessionCapabilities['modes']> {
+  const options = deps.catalog.options
+  const current = (): string => currentPreset(deps.projections, deps.sessionId)
+  return {
+    list(): readonly ModeOption[] {
+      return options.map(option => {
+        const localized = permissionPresetKeys(option) !== undefined
+        const description = localized
+          ? permissionPresetDescription(option)
+          : option.description
+        return {
+          id: option.value,
+          label: permissionPresetLabel(option),
+          ...(description === undefined ? {} : { description }),
+        }
+      })
+    },
+    current,
+    async set(id: string): Promise<void> {
+      if (!options.some(option => option.value === id)) {
+        throw new Error(`remote: unknown permission preset "${id}"`)
+      }
+      const result = await deps.execute(`/permission ${id}`)
+      if (!result.ok) {
+        throw new Error(`remote: /permission ${id} failed: ${result.error?.message ?? 'unknown error'}`)
+      }
+      const deadline = Date.now() + 2_000
+      while (Date.now() < deadline) {
+        if (current() === id) return
+        await new Promise<void>(resolve => setTimeout(resolve, 50))
+      }
+      throw new Error(`remote: the Host did not confirm permission preset "${id}"`)
+    },
+  }
+}
